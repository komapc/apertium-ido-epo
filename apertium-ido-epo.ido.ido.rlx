# Constraint Grammar for Ido (ido)  --  GENERATED FILE, DO NOT EDIT.
# Regenerate with: python3 dev/gen_ido_disambig.py
# (built by the Makefile from the monodix + compiled bidix).
#
# Resolves the "der-shadow" ambiguity: Ido paradigms auto-generate productive
# derivations (der_aj, der_izar, der_qual, der_act, der_pres, der_aro) for every root, so a surface like vilajo
# analyses both as the phantom root+suffix AND as the real lexicalized word.
# With no disambiguation in ido->epo the phantom wins (-> @vil). A baseform is
# listed in SAFELEX (and its derivation reading dropped) only when verified at
# build time against the bidix, so we never turn a usable fallback into a visible
# @-gap. Two policies: for der_aj, der_izar the lexical reading is the real
# word, so prefer it whenever it translates; for der_qual, der_act, der_pres, der_aro the
# derivation is usually correct, so prefer lexical only when the derivation is an
# @-gap OR the lexical translation is clearly more cognate to the surface than
# the derivation's (quanto: der=kvar vs lex=kvanto, while prezidanto stays der).
# Mirrors the cg-proc stage epo-ido already uses.

DELIMITERS = "<.>" "<!>" "<?>" "<...>" ;

# In-scope productive derivation tags.
LIST DER = der_aj der_izar der_qual der_act der_pres der_aro ;

# Lexicalized baseforms whose lexical reading is bidix-translatable, i.e. safe
# to prefer over the phantom derivation. Generated from bidix coverage.
LIST SAFELEX =
	"Sensencaj"
	"acentiz"
	"acidiz"
	"aeriz"
	"almonaj"
	"altar"
	"ambaj"
	"analogaj"
	"aplikaj"
	"aquiraj"
	"asemblaj"
	"aviacad"
	"aviz"
	"bandaj"
	"bandajiz"
	"barbaraj"
	"bitraj"
	"brechiz"
	"bronziz"
	"dementes"
	"digiz"
	"dignes"
	"dokumentiz"
	"domaj"
	"emaliiz"
	"equipaj"
	"evangeliiz"
	"eventaj"
	"evidentaj"
	"expertiz"
	"farbiz"
	"figuriz"
	"fiktivaj"
	"freques"
	"frigoriz"
	"fromaj"
	"frustrad"
	"glaciaj"
	"grosieraj"
	"heroaj"
	"hipotekiz"
	"homaj"
	"impostiz"
	"kanoniz"
	"kargaj"
	"kateniz"
	"kloakaj"
	"kolektaj"
	"kombusteblaj"
	"komercaj"
	"konceptaj"
	"konstruaj"
	"kontributaj"
	"korsaj"
	"koruptaj"
	"kruelaj"
	"kuraj"
	"lidiz"
	"lumiz"
	"magnetiz"
	"materiaj"
	"mesaj"
	"miraj"
	"plakiz"
	"plantiz"
	"polutad"
	"posedaj"
	"posiblaj"
	"preferaj"
	"prodaj"
	"projektaj"
	"propraj"
	"proprietaj"
	"proviz"
	"quales"
	"radar"
	"restaj"
	"reviz"
	"sekretaj"
	"sensencaj"
	"singulares"
	"slangaj"
	"sodaj"
	"stretaj"
	"sulkiz"
	"totaj"
	"ventiz"
	"veraj"
	"vestiz"
	"vicinaj"
	"vizaj"
	"voyaj"
	"zelant" ;

# SAFELEX restricted to NON-derivation readings: a derivation whose own lemma
# happens to be in SAFELEX (e.g. popular<der_qual>, lemma "popular") must not
# satisfy the condition and remove itself.
SET SAFELEXLEX = SAFELEX - DER ;

SECTION

# Drop the phantom derivation when a verified-translatable lexicalized reading
# for the same surface exists in the cohort.
REMOVE DER IF (0 SAFELEXLEX) ;
