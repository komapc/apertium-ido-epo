<?xml version="1.0" encoding="UTF-8"?>
<dictionary>
  <alphabet/>
  <!-- No Ido post-generation rules yet. The schema requires one entry, so this
       identity keeps the epo-ido mode's post-generation stage valid: it applies
       only to a word the generator marks with an alarm, and changes nothing. -->
  <section id="main" type="standard">
    <e><p><l><a/>a</l><r>a</r></p></e>
  </section>
</dictionary>
