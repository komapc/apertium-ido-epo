# Constraint Grammar for Esperanto (epo)  --  GENERATED FILE, DO NOT EDIT.
# Regenerate with: make regen-disambig-epo  (dev/gen_epo_disambig.py)
#
# epo->ido has no tagger, so transfer takes the first reading the analyser
# lists, and apertium-epo's order often puts an untranslatable reading first
# (ke<adv> before ke<cnjsub>, Li<np> before the pronoun). Each rule below drops
# readings that come out of bidix+transfer+generation as an @/# gap, and fires
# only when the cohort also holds a reading verified at build time to
# translate. Rules are grouped by tag pattern with lemma lists (vislcg3 tries
# every rule on every window, so one rule per word was ~100x slower); each
# group was checked against the whole dictionary never to remove a reading
# that translates.

DELIMITERS = "<.>" "<!>" "<?>" "<...>" "<¶>" ;

LIST nom = (n) ;
LIST det = (det) ;
LIST prntn = (prn tn) ;
# apertium-epo also reads some correlatives as adjectives (iu<adj>): the
# modifier readings, whichever tag they carry.
SET modifier = det OR (adj) ;
SET nominal = (n) OR (adj) OR (np) ;

# Lemma lists of the generated rules (BADn: lemmas whose reading is dropped,
# GOODn: lemmas whose translating reading must be present).
LIST BAD0 = "do" "Do" ;
LIST GOOD0 = "do" "Do" ;
SET BADT0 = BAD0 - (cnjadv) ;
LIST BAD1 = "de" "De" ;
LIST GOOD1 = "de" "De" ;
SET BADT1 = BAD1 - (pr) ;
LIST BAD2 = "adoptita" "Adoptita" "agita" "Agita" "akcentita" "Akcentita" "antaŭvidita" "Antaŭvidita" "anticipita" "Anticipita" "benita" "Benita" "bindita" "Bindita" "boligita" "Boligita" "dekoltita" "Dekoltita" "deprimita" "Deprimita" "dilatita" "Dilatita" "distrita" "Distrita" "dotita" "Dotita" "ekzaltita" "Ekzaltita" "ekzercita" "Ekzercita" "eskapita" "Eskapita" "estingita" "Estingita" "federita" "Federita" "finita" "Finita" "flikita" "Flikita" "forgesita" "Forgesita" "fritita" "Fritita" "improvizita" "Improvizita" "izolita" "Izolita" "kaŝita" "Kaŝita" "koncernita" "Koncernita" "kondamnita" "Kondamnita" "kondiĉita" "Kondiĉita" "konsternita" "Konsternita" "konsumita" "Konsumita" "kontraŭita" "Kontraŭita" "konvinkita" "Konvinkita" "kortuŝita" "Kortuŝita" "liberigita" "Liberigita" "malbenita" "Malbenita" "malpermesita" "Malpermesita" "meditita" "Meditita" "miksita" "Miksita" "miskomprenita" "Miskomprenita" "naskita" "Naskita" "nomumita" "Nomumita" "okupita" "Okupita" "ordigita" "Ordigita" "ornamita" "Ornamita" "perfortita" "Perfortita" "plisita" "Plisita" "presita" "Presita" "projektita" "Projektita" "prosperita" "Prosperita" "rafinita" "Rafinita" "razita" "Razita" "rekomendita" "Rekomendita" "rezervita" "Rezervita" "rostita" "Rostita" "skribita" "Skribita" "timigita" "Timigita" "trovita" "Trovita" "uzita" "Uzita" "ŝarĝita" "Ŝarĝita" ;
LIST GOOD2 = "adopti" "Adopti" "agi" "Agi" "akcenti" "Akcenti" "antaŭvidi" "Antaŭvidi" "anticipi" "Anticipi" "beni" "Beni" "bindi" "Bindi" "boligi" "Boligi" "dekolti" "Dekolti" "deprimi" "Deprimi" "dilati" "Dilati" "distri" "Distri" "doti" "Doti" "ekzalti" "Ekzalti" "ekzerci" "Ekzerci" "eskapi" "Eskapi" "estingi" "Estingi" "federi" "Federi" "fini" "Fini" "fliki" "Fliki" "forgesi" "Forgesi" "friti" "Friti" "improvizi" "Improvizi" "izoli" "Izoli" "kaŝi" "Kaŝi" "koncerni" "Koncerni" "kondamni" "Kondamni" "kondiĉi" "Kondiĉi" "konsterni" "Konsterni" "konsumi" "Konsumi" "kontraŭi" "Kontraŭi" "konvinki" "Konvinki" "kortuŝi" "Kortuŝi" "liberigi" "Liberigi" "malbeni" "Malbeni" "malpermesi" "Malpermesi" "mediti" "Mediti" "miksi" "Miksi" "miskompreni" "Miskompreni" "naski" "Naski" "nomumi" "Nomumi" "okupi" "Okupi" "ordigi" "Ordigi" "ornami" "Ornami" "perforti" "Perforti" "plisi" "Plisi" "presi" "Presi" "projekti" "Projekti" "prosperi" "Prosperi" "rafini" "Rafini" "razi" "Razi" "rekomendi" "Rekomendi" "rezervi" "Rezervi" "rosti" "Rosti" "skribi" "Skribi" "timigi" "Timigi" "trovi" "Trovi" "uzi" "Uzi" "ŝarĝi" "Ŝarĝi" ;
