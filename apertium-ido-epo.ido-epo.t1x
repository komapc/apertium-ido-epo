<?xml version="1.0" encoding="UTF-8"?>
<transfer default="lu">
  <section-def-cats>
    <def-cat n="nom">
      <cat-item tags="n.*"/>
    </def-cat>
    <def-cat n="adj">
      <cat-item tags="adj"/>
      <cat-item tags="adj.*"/>
    </def-cat>
    <def-cat n="adv">
      <cat-item tags="adv"/>
      <cat-item tags="adv.*"/>
    </def-cat>
    <!-- Derived nouns from verbs/adjectives: kre<vblex><der_pres>, bon<adj><der_qual>, etc.
         Must be listed BEFORE vblex/adj so these take priority in pattern matching. -->
    <def-cat n="der_nom">
      <cat-item tags="vblex.der_pres.*"/>
      <cat-item tags="vblex.der_act.*"/>
      <cat-item tags="vblex.der_past.*"/>
      <cat-item tags="vblex.der_onto.*"/>
      <cat-item tags="vblex.der_ppa.*"/>
      <cat-item tags="vblex.der_ppas.*"/>
      <cat-item tags="vblex.der_pprs.*"/>
      <cat-item tags="vblex.der_pfut.*"/>
      <cat-item tags="vblex.der_ppra.*"/>
      <cat-item tags="vblex.der_onta.*"/>
      <cat-item tags="vblex.der_ante.*"/>
      <cat-item tags="vblex.der_inte.*"/>
      <cat-item tags="vblex.der_onte.*"/>
      <cat-item tags="vblex.der_ate.*"/>
      <cat-item tags="vblex.der_ite.*"/>
      <cat-item tags="vblex.der_ote.*"/>
      <cat-item tags="adj.der_qual.*"/>
      <cat-item tags="n.der_ala.adj.*"/>
      <cat-item tags="n.der_oz.adj.*"/>
      <cat-item tags="n.der_izar.vblex.*"/>
    </def-cat>
    <def-cat n="vblex">
      <cat-item tags="vblex.*"/>
    </def-cat>
    <def-cat n="vbconj">
      <cat-item tags="vblex.pri.*"/>
      <cat-item tags="vblex.pii.*"/>
      <cat-item tags="vblex.fti.*"/>
      <cat-item tags="vblex.cni.*"/>
      <cat-item tags="vblex.imp.*"/>
      <!-- Support for cases where pasv is present -->
      <cat-item tags="vblex.pri.pasv.*"/>
      <cat-item tags="vblex.pii.pasv.*"/>
      <cat-item tags="vblex.fti.pasv.*"/>
      <cat-item tags="vblex.cni.pasv.*"/>
      <cat-item tags="vblex.imp.pasv.*"/>
    </def-cat>
    <def-cat n="vbser">
      <cat-item lemma="esar" tags="vblex.*"/>
      <cat-item lemma="es" tags="vblex.*"/>
    </def-cat>
    <!-- Non-esar copulative verbs that also take an agreeing predicate adjective
         (Eo: "la domoj fariĝis novaj", "la homoj restas feliĉaj"). The Ido
         analyser emits the bare stem as the verb lemma (divenis→diven<vblex>),
         so match the stem; infinitive forms listed too for safety. -->
    <def-cat n="vbcop">
      <cat-item lemma="diven"   tags="vblex.*"/>  <!-- divenar = become -> fariĝi -->
      <cat-item lemma="divenar" tags="vblex.*"/>
      <cat-item lemma="rest"    tags="vblex.*"/>  <!-- restar  = remain -> resti  -->
      <cat-item lemma="restar"  tags="vblex.*"/>
      <cat-item lemma="sembl"   tags="vblex.*"/>  <!-- semblar = seem   -> ŝajni  -->
      <cat-item lemma="semblar" tags="vblex.*"/>
    </def-cat>
    <def-cat n="vbintr">
      <cat-item lemma="jacar" tags="vblex.*"/>
      <cat-item lemma="venar" tags="vblex.*"/>
      <cat-item lemma="irar" tags="vblex.*"/>
      <cat-item lemma="star" tags="vblex.*"/>
      <cat-item lemma="mortar" tags="vblex.*"/>
      <cat-item lemma="dormar" tags="vblex.*"/>
      <cat-item lemma="arivir" tags="vblex.*"/>
      <cat-item lemma="departir" tags="vblex.*"/>
      <cat-item lemma="aparar" tags="vblex.*"/>
      <cat-item lemma="exisar" tags="vblex.*"/>
      <cat-item lemma="existar" tags="vblex.*"/>
      <cat-item lemma="restar" tags="vblex.*"/>
    </def-cat>
    <def-cat n="prn">
      <cat-item tags="prn"/>
      <cat-item tags="prn.*"/>
    </def-cat>
    <!-- Unambiguously-plural personal pronouns (Ido li=they, ni=we). Used to agree
         a predicate adjective with a pronoun subject. vu/vi (you) is excluded — its
         number is ambiguous (polite singular or plural) so pluralizing would regress. -->
    <def-cat n="prn_pl">
      <cat-item lemma="li" tags="prn"/>
      <cat-item lemma="ni" tags="prn"/>
    </def-cat>
    <!-- The reflexive pronoun only (Ido su). Used by the pr+prn_ref rule to keep
         a prepositional reflexive nominative (pri su → pri si), while the bare
         object case (lavas su → lavas sin) stays accusative via the standalone
         pronoun rule. Lemma-targeted so personal pronouns are untouched. -->
    <def-cat n="prn_ref">
      <cat-item lemma="su" tags="prn"/>
      <cat-item lemma="su" tags="prn.*"/>
    </def-cat>
    <!-- Ido "qua" ("who"/"which") doubles as an interrogative determiner
         before a noun (qua libro → which book), unlike "quo" ("what"),
         which is only ever a standalone pronoun. Bidix maps it to bare EO
         "kiu<prn>"; used attributively it must be re-emitted as <det><itg>
         agreeing with the noun (see the prn_itg+nom rule family below,
         #205) instead of falling through to the generic prn_to_obj/subj
         dispatch (which would wrongly consume the noun-less "kiu" alone and
         leave the following noun uninflected: "qua libro" → "kiun libro"). -->
    <def-cat n="prn_itg">
      <cat-item lemma="qua" tags="prn"/>
      <cat-item lemma="Qua" tags="prn"/>
    </def-cat>
    <!-- Equative correlative pair: tam X kam → tiel X kiel. kam's bare bidix
         value stays 'ol' (the comparative "than" reading: plu forta kam → pli
         forta ol); the equative reading is selected by the tam … kam pattern. -->
    <def-cat n="adv_tam">
      <cat-item lemma="tam" tags="adv"/>
      <cat-item lemma="Tam" tags="adv"/>
    </def-cat>
    <def-cat n="adv_kam">
      <cat-item lemma="kam" tags="adv"/>
      <cat-item lemma="Kam" tags="adv"/>
    </def-cat>
    <def-cat n="prep_art">
      <cat-item tags="pr.def"/>
    </def-cat>
    <def-cat n="pr">
      <cat-item tags="pr"/>
      <cat-item tags="pr.*"/>
    </def-cat>
    <!-- Dative-marking "to" (a/ad), restricted from the generic "pr" category
         so the ditransitive word-order rules below (#204) only fire for a
         genuine indirect-object preposition, not "en"/"pri"/etc. -->
    <def-cat n="pr_dat">
      <cat-item lemma="a" tags="pr"/>
      <cat-item lemma="ad" tags="pr"/>
    </def-cat>
    <def-cat n="cnjcoo">
      <cat-item tags="cnjcoo"/>
      <cat-item tags="cnjcoo.*"/>
    </def-cat>
    <def-cat n="cnjsub">
      <cat-item tags="cnjsub"/>
      <cat-item tags="cnjsub.*"/>
    </def-cat>
    <def-cat n="det">
      <cat-item tags="det"/>
      <cat-item tags="det.*"/>
    </def-cat>
    <def-cat n="np">
      <cat-item tags="np"/>
      <cat-item tags="np.*"/>
    </def-cat>
    
    <!-- PASSIVE VOICE verbs: Ido uses synthetic passive with -es- infix
         kreesar (passive inf), kreesas (passive pres), kreesis (passive past), etc.
         These need to be converted to Esperanto periphrastic passive (esti + participle) -->
    <def-cat n="vbpasv">
      <cat-item tags="vblex.pasv.*"/>
      <cat-item tags="vblex.*.pasv"/>
      <cat-item tags="vblex.*.pasv.*"/>
      <cat-item tags="vblex.der_esar.vblex.*"/>
    </def-cat>
    
    <!-- PARTICIPLES: verb forms used as adjectives/adverbs
         Present: -ante (derivante = deriving)
         Past: -inte (derivinte = having derived)
         Future: -onte (derivonte = about to derive) -->
    <def-cat n="pprs">
      <cat-item tags="vblex.pprs"/>
      <cat-item tags="vblex.pprs.*"/>
    </def-cat>
    
    <def-cat n="pp">
      <cat-item tags="vblex.pp"/>
      <cat-item tags="vblex.pp.*"/>
    </def-cat>
    <def-cat n="num">
      <cat-item tags="num"/>
      <cat-item tags="num.*"/>
    </def-cat>
    <!-- The "and" conjunction (Ido e/ed), used only to drop it between numerals:
         Ido writes compound numbers with it (dek e du), Esperanto juxtaposes
         (dek du). NOT the "or" conjunction (o/od), which must stay (aŭ). -->
    <def-cat n="cnjcoo_e">
      <cat-item lemma="e" tags="cnjcoo"/>
      <cat-item lemma="ed" tags="cnjcoo"/>
    </def-cat>
    <!-- Quantifier-adjectives mis-tagged <num> in the lexicon (kelka=some,
         multa=many, diversa=diverse, cetera=remaining). Unlike cardinals
         (du/tri) and the correlative tanta→tiom, these AGREE in Esperanto
         (kelkaj, multaj). Listed by lemma so cardinals are untouched. -->
    <def-cat n="quant">
      <cat-item lemma="kelka" tags="num"/>
      <cat-item lemma="multa" tags="num"/>
      <cat-item lemma="diversa" tags="num"/>
      <cat-item lemma="cetera" tags="num"/>
    </def-cat>
    <!-- Ido determiner correlatives (analyzed as adj) whose EO equivalents are
         -u tabelvortoj (ĉiu/iu/neniu/tiu). The EO generator has no <adj> entry
         for most of them (#ĉiu), so the corr_u+nom rule re-emits them as
         <prn><tn> with the noun's number/case (omna homi → ĉiuj homoj). -->
    <def-cat n="corr_u">
      <cat-item lemma="omn" tags="adj"/>
      <cat-item lemma="Omn" tags="adj"/>
      <cat-item lemma="ul" tags="adj"/>
      <cat-item lemma="Ul" tags="adj"/>
      <cat-item lemma="irg" tags="adj"/>
      <cat-item lemma="Irg" tags="adj"/>
      <cat-item lemma="nul" tags="adj"/>
      <cat-item lemma="Nul" tags="adj"/>
      <cat-item lemma="it" tags="adj"/>
      <cat-item lemma="It" tags="adj"/>
      <cat-item lemma="t" tags="adj"/>
      <cat-item lemma="T" tags="adj"/>
      <cat-item lemma="ic" tags="adj"/>
      <cat-item lemma="Ic" tags="adj"/>
      <cat-item lemma="c" tags="adj"/>
      <cat-item lemma="C" tags="adj"/>
    </def-cat>
    <!-- Ido partitive-quantity correlatives tanta/quanta ("so much/many" /
         "how much/many"). The bidix maps them to bare EO "tiom"/"kiom", but
         those lemmas are only generatable as the invariant multiword "tiom
         da"/"kiom da" (apertium-epo requires the following noun with "da",
         bare/uninflected: "tiom domoj" doesn't exist, only "tiom da domoj").
         Matched by SL lemma so cardinals/other <num>/<adj> words are untouched;
         see the corr_da+nom rule family below (#206). -->
    <def-cat n="corr_da">
      <cat-item lemma="tanta" tags="num"/>
      <cat-item lemma="Tanta" tags="num"/>
      <cat-item lemma="quant" tags="adj"/>
      <cat-item lemma="Quant" tags="adj"/>
    </def-cat>
    <def-cat n="ord">
      <cat-item tags="num.ord"/>
      <cat-item tags="num.ord.*"/>
    </def-cat>
  </section-def-cats>

  <section-def-attrs>
    <def-attr n="a_nom">
      <attr-item tags="n"/>
    </def-attr>
    <def-attr n="a_adj">
      <attr-item tags="adj"/>
    </def-attr>
    <def-attr n="a_adv">
      <attr-item tags="adv"/>
    </def-attr>
    <def-attr n="a_vblex">
      <attr-item tags="vblex"/>
    </def-attr>
    <def-attr n="a_prn">
      <attr-item tags="prn"/>
    </def-attr>
    <def-attr n="nbr">
      <attr-item tags="sg"/>
      <attr-item tags="pl"/>
      <attr-item tags="sp"/>
    </def-attr>
    <def-attr n="cas">
      <attr-item tags="nom"/>
      <attr-item tags="acc"/>
    </def-attr>
    <def-attr n="temps">
      <attr-item tags="inf"/>
      <attr-item tags="pri"/><attr-item tags="pres"/>
      <attr-item tags="pii"/><attr-item tags="past"/>
      <attr-item tags="fti"/><attr-item tags="fut"/>
      <attr-item tags="cni"/>
      <attr-item tags="imp"/>
      <attr-item tags="pres"/>
      <attr-item tags="past"/>
    </def-attr>
    
    <!-- Voice attribute: active or passive -->
    <def-attr n="voice">
      <attr-item tags="pasv"/>
      <attr-item tags="act"/>
    </def-attr>
    
    <!-- Participle types -->
    <def-attr n="part">
      <attr-item tags="pprs"/>  <!-- present participle (-ante) -->
      <attr-item tags="pp"/>    <!-- past participle (-ita/-inta) -->
      <attr-item tags="pfut"/>  <!-- future participle (-onte/-ota) -->
    </def-attr>
    <!-- Proper noun subtypes -->
    <def-attr n="np_type">
      <attr-item tags="al"/>
      <attr-item tags="loc"/>
      <attr-item tags="ant"/>
      <attr-item tags="cog"/>
    </def-attr>
    <!-- Person and gender -->
    <def-attr n="pers">
      <attr-item tags="p1"/>
      <attr-item tags="p2"/>
      <attr-item tags="p3"/>
    </def-attr>
    <def-attr n="gen">
      <attr-item tags="m"/>
      <attr-item tags="f"/>
      <attr-item tags="mf"/>
      <attr-item tags="nt"/>
    </def-attr>
  </section-def-attrs>

  <section-def-vars>
    <def-var n="dummy"/>
  </section-def-vars>

  <section-def-macros>
    <def-macro n="pii_to_past" npar="1">
      <!-- Ido past indicative <pii> has no Esperanto generation form (the EO
           generator only knows <past>), so a finite past verb otherwise falls
           back to the infinitive (dominacis -> "domini"). Rewrite the target
           tense before output; harmless for any non-<pii> unit. -->
      <choose>
        <when>
          <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pii"/></equal></test>
          <let><clip pos="1" side="tl" part="temps"/><lit-tag v="past"/></let>
        </when>
      </choose>
    </def-macro>
    <!-- Map an Ido finite tense to the Esperanto generation tense on the TL
         unit (pri->pres, pii->past; fti and others pass through unchanged).
         Used so a copula can be output via clip part="temps" instead of an
         inline 4-way <choose>. -->
    <def-macro n="io_to_eo_tense" npar="1">
      <choose>
        <when>
          <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pri"/></equal></test>
          <let><clip pos="1" side="tl" part="temps"/><lit-tag v="pres"/></let>
        </when>
        <when>
          <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pii"/></equal></test>
          <let><clip pos="1" side="tl" part="temps"/><lit-tag v="past"/></let>
        </when>
      </choose>
    </def-macro>
    <!-- ── Pronoun → Esperanto prpers mapping ───────────────────────────────
         Ido pronouns reach transfer as the bare Esperanto lemma from the bidix
         (me→mi<prn>, tu→ci<prn>, …); the Eo generator needs the full prpers
         form with person/gender/number AND case. prn_to_subj emits the
         NOMINATIVE (subject / isolated / predicate) reading, prn_to_obj the
         ACCUSATIVE (direct-object) reading. Factored out so the standalone
         pronoun rule (pos 1) and the verb+pronoun object rules (pos 2) share
         one lemma→features table instead of duplicating it. The reflexive si
         stays accusative in both (a bare reflexive is an object). -->
    <def-macro n="prn_to_subj" npar="1">
      <choose>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="si"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="si"/></get-case-from><lit-tag v="prn"/><lit-tag v="ref"/><lit-tag v="acc"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="mi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p1"/><lit-tag v="mf"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ni"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p1"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="vi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p2"/><lit-tag v="mf"/><lit-tag v="sp"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ci"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p2"/><lit-tag v="mf"/><lit-tag v="sp"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="li"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p3"/><lit-tag v="m"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ŝi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p3"/><lit-tag v="f"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ĝi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p3"/><lit-tag v="nt"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ili"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p3"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ŝiaro"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p3"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ĝiaro"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="subj"/><lit-tag v="p3"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="oni"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="oni"/></get-case-from><lit-tag v="prn"/><lit-tag v="tn"/><lit-tag v="sg"/><lit-tag v="nom"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="tiu"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="tiu"/></get-case-from><lit-tag v="prn"/><lit-tag v="tn"/><lit-tag v="sg"/><lit-tag v="nom"/></lu></out>
        </when>
        <!-- qua/quo ("who"/"what", #205): the bidix hands over the bare
             lemma (kiu/kio<prn>, no itg/sg/cas), which the EO generator
             rejects outright: minimum tags are itg-or-rel + sg/pl +
             nom/acc. Source doesn't distinguish number, so default sg. -->
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="kiu"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="kiu"/></get-case-from><lit-tag v="prn"/><lit-tag v="itg"/><lit-tag v="sg"/><lit-tag v="nom"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="kio"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="kio"/></get-case-from><lit-tag v="prn"/><lit-tag v="itg"/><lit-tag v="sg"/><lit-tag v="nom"/></lu></out>
        </when>
        <otherwise>
          <out><lu><clip pos="1" side="tl" part="whole"/></lu></out>
        </otherwise>
      </choose>
    </def-macro>
    <def-macro n="prn_to_obj" npar="1">
      <choose>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="si"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="si"/></get-case-from><lit-tag v="prn"/><lit-tag v="ref"/><lit-tag v="acc"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="mi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p1"/><lit-tag v="mf"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ni"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p1"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="vi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p2"/><lit-tag v="mf"/><lit-tag v="sp"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ci"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p2"/><lit-tag v="mf"/><lit-tag v="sp"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="li"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p3"/><lit-tag v="m"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ŝi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p3"/><lit-tag v="f"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ĝi"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p3"/><lit-tag v="nt"/><lit-tag v="sg"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ili"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p3"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ŝiaro"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p3"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ĝiaro"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="prpers"/></get-case-from><lit-tag v="prn"/><lit-tag v="obj"/><lit-tag v="p3"/><lit-tag v="mf"/><lit-tag v="pl"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="oni"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="oni"/></get-case-from><lit-tag v="prn"/><lit-tag v="tn"/><lit-tag v="sg"/><lit-tag v="nom"/></lu></out>
        </when>
        <when>
          <!-- Direct-object position: accusative, not the nominative "tiu"
               takes as a subject/predicate in prn_to_subj above. Currently
               unreachable (no bidix pair maps to bare tl lemma "tiu"), but
               correct-in-principle should one appear. -->
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="tiu"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="tiu"/></get-case-from><lit-tag v="prn"/><lit-tag v="tn"/><lit-tag v="sg"/><lit-tag v="acc"/></lu></out>
        </when>
        <!-- qua/quo object (#205): same tag gap as prn_to_subj, accusative. -->
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="kiu"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="kiu"/></get-case-from><lit-tag v="prn"/><lit-tag v="itg"/><lit-tag v="sg"/><lit-tag v="acc"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="kio"/></equal></test>
          <out><lu><get-case-from pos="1"><lit v="kio"/></get-case-from><lit-tag v="prn"/><lit-tag v="itg"/><lit-tag v="sg"/><lit-tag v="acc"/></lu></out>
        </when>
        <otherwise>
          <out><lu><clip pos="1" side="tl" part="whole"/></lu></out>
        </otherwise>
      </choose>
    </def-macro>
    <!-- Redirect an Ido conjunction reaching the TL as one of the words that
         cannot generate under <cnjcoo> (see the standalone cnjcoo rule
         below for the lt-proc -g evidence) to whichever tag its own
         Esperanto dictionary entry actually supports. Factored into a
         macro so every rule that matches a cnjcoo pattern-item — not just
         the standalone-conjunction rule — applies the same redirect,
         including the "noun cnjcoo noun" family of coordination rules
         where the conjunction sits inside a longer pattern. -->
    <def-macro n="cnjcoo_lu" npar="1">
      <choose>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ke"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjsub"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="se"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjadv"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ĉu"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjadv"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="kvankam"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjadv"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="ĉar"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjadv"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="tamen"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjadv"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="do"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjadv"/></lu></out>
        </when>
        <when>
          <test><equal caseless="yes"><clip pos="1" side="tl" part="lem"/><lit v="nu"/></equal></test>
          <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="cnjadv"/></lu></out>
        </when>
        <otherwise>
          <out><lu><clip pos="1" side="tl" part="whole"/></lu></out>
        </otherwise>
      </choose>
    </def-macro>
  </section-def-macros>


  <section-rules>
    <!-- ============================================================================
         COPULA RULES (vbser category - matches lemma "esar" or "es")
         
         LINGUISTIC CONTEXT:
         The copula verb (esar → esti, "to be") is fundamental to the difference
         between Ido and Esperanto's case systems. Both languages use nominative
         case for copula predicates (predicate nominatives and predicate adjectives).
         
         Reference: https://en.wikipedia.org/wiki/Comparison_between_Esperanto_and_Ido
         - Esperanto: "Li estas instruisto" (nominative predicate)
         - Ido: "Il esas docanto" (no case marking on nouns)
         
         TECHNICAL NOTES:
         These rules have PRIORITY over vblex rules due to lemma-based matching.
         They handle simple copula patterns (copula + predicate).
         
         Complex patterns (e.g., copula + det + noun, coordinations) are handled
         by vblex rules below with explicit copula checking.
         
         Copula predicates remain in NOMINATIVE case (unlike transitive objects).
         ============================================================================ -->
    
    <!-- Derived nouns (kreanto, kreado, boneso → boneco): pass through as plain nouns.
         The bilingual dict has already resolved the Esperanto form; the transfer just
         outputs it unchanged. Must appear first to beat vblex catch-all rules. -->
    <!-- Adjective/quantifier + DERIVED noun (der_nom: -ado/-anto/-ilo… heads like
         moviĝado, konkuranto). der_nom is matched before `nom`, so the plain
         `adj nom`/`quant nom` rules miss it and the modifier stays singular
         ("arta moviĝadoj" → should be "artaj…"). Same agreement, der_nom head. -->
    <rule>
      <pattern>
        <pattern-item n="adj"/>
        <pattern-item n="der_nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_adj"/><clip pos="2" side="tl" part="nbr"/><clip pos="2" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <rule>
      <pattern>
        <pattern-item n="quant"/>
        <pattern-item n="der_nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="lem"/><lit-tag v="adj"/><clip pos="2" side="tl" part="nbr"/><clip pos="2" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <rule comment="derived noun passthrough">
      <pattern>
        <pattern-item n="der_nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Copula (esar/esti) + Adjective + Noun: keep nominative (predicate)
         
         Handles: "Il esas bela kato" → "Li estas bela kato"
         
         LINGUISTIC: In both languages, predicate adjectives with copula don't take
         accusative. Esperanto adjectives agree with the noun in number. -->
    <rule>
      <pattern>
        <pattern-item n="vbser"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pri"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="pres"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pii"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="past"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="fti"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="fti"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><clip pos="1" side="sl" part="temps"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Copula + Noun: keep nominative (predicate nominative)
         
         Handles: "Il esas docanto" → "Li estas instruisto"
         
         LINGUISTIC: Predicate nominatives identify or rename the subject.
         Both Ido and Esperanto keep predicates after copula in nominative case.
         This contrasts with transitive verbs which govern accusative objects. -->
    <rule>
      <pattern>
        <pattern-item n="vbser"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pri"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="pres"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="whole"/></lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pii"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="past"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="whole"/></lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="fti"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="fti"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><clip pos="1" side="sl" part="temps"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="whole"/></lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Copula + Adjective: keep nominative, add sg/nom
         
         Handles: "La kato esas bela" → "La kato estas bela"
         
         LINGUISTIC: Predicate adjectives after copula describe the subject.
         KEY DIFFERENCE: Ido adjectives are invariable; Esperanto adjectives
         must agree in number and case with what they modify.
         Reference: https://en.wikipedia.org/wiki/Comparison_between_Esperanto_and_Ido#Morphology
         - Ido: "bela" (always invariable)
         - Esperanto: "bela" (sg), "belaj" (pl), "belan" (sg+acc), "belajn" (pl+acc) -->
    <rule>
      <pattern>
        <pattern-item n="vbser"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pri"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="pres"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pii"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="past"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="fti"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><lit-tag v="fti"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_vblex"/><clip pos="1" side="sl" part="temps"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Subject + Copula + Predicate adjective: agree the predicate adjective
         with the SUBJECT's number (Eo: "la katoj estas belaj", not "...bela").
         The bare `vbser adj` rule above can't see the subject (it's across the
         copula) so it defaults to sg; these wider patterns carry the subject
         noun's number to the predicate adjective. Det and bare-noun subjects;
         pronoun subjects are skipped (Ido `li` carries no number tag). -->
    <rule>
      <pattern>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
        <pattern-item n="vbser"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="3"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_vblex"/><clip pos="3" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="4" side="tl" part="lem"/><clip pos="4" side="tl" part="a_adj"/><clip pos="2" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>
    <rule>
      <pattern>
        <pattern-item n="nom"/>
        <pattern-item n="vbser"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="2"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_vblex"/><clip pos="2" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><clip pos="1" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>

    <!-- Pre-modified subject + copula + predicate adjective: the subject NP has
         an attributive adjective, so the bare `nom vbser adj` rule can't see the
         subject noun. Agree both the attributive adj and the predicate adj with
         the subject noun: "granda urbi esas bela" → "grandaj urboj estas belaj". -->
    <rule>
      <pattern>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
        <pattern-item n="vbser"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="3"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_adj"/><clip pos="2" side="tl" part="nbr"/><clip pos="2" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_vblex"/><clip pos="3" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="4" side="tl" part="lem"/><clip pos="4" side="tl" part="a_adj"/><clip pos="2" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>
    <rule>
      <pattern>
        <pattern-item n="det"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
        <pattern-item n="vbser"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="4"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><clip pos="3" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="4" side="tl" part="lem"/><clip pos="4" side="tl" part="a_vblex"/><clip pos="4" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="5" side="tl" part="lem"/><clip pos="5" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>

    <!-- Same predicate-adjective agreement for non-esar copulatives (vbcop:
         divenar/restar/semblar): "la domoj fariĝis novaj", "la homoj restas
         feliĉaj". -->
    <rule>
      <pattern>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
        <pattern-item n="vbcop"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="3"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_vblex"/><clip pos="3" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="4" side="tl" part="lem"/><clip pos="4" side="tl" part="a_adj"/><clip pos="2" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>
    <rule>
      <pattern>
        <pattern-item n="nom"/>
        <pattern-item n="vbcop"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="2"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_vblex"/><clip pos="2" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><clip pos="1" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>

    <!-- Plural-pronoun subject + copula + predicate adjective: "li esas bela" →
         "ili estas belaj", "ni restas forta" → "ni restas fortaj". The pronoun has
         no number attribute, so the predicate adjective takes a literal <pl>. -->
    <rule>
      <pattern>
        <pattern-item n="prn_pl"/>
        <pattern-item n="vbser"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="2"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_vblex"/><clip pos="2" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><lit-tag v="pl"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>
    <rule>
      <pattern>
        <pattern-item n="prn_pl"/>
        <pattern-item n="vbcop"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="io_to_eo_tense"><with-param pos="2"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_vblex"/><clip pos="2" side="tl" part="temps"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><lit-tag v="pl"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>

    <!-- ============================================================================
         PASSIVE VOICE RULES

         LINGUISTIC CONTEXT:
         Ido uses a SYNTHETIC passive with the -es- infix:
         - kreesar (passive infinitive: to be created)
         - kreesas (passive present: is being created)
         - kreesis (passive past: was created)
         - kreesos (passive future: will be created)
         
         Esperanto uses a PERIPHRASTIC passive with esti + participle:
         - esti kreita (to be created) - infinitive
         - estas kreata (is being created) - present progressive
         - estis kreita (was created) - past
         - estos kreita (will be created) - future
         
         Reference: https://en.wikipedia.org/wiki/Comparison_between_Esperanto_and_Ido#Verb_morphology
         
         TRANSLATION STRATEGY:
         - Passive present → estas + present passive participle (-ata)
         - Passive past → estis + past passive participle (-ita)
         - Passive future → estos + past passive participle (-ita)
         - Passive infinitive → esti + past passive participle (-ita)
         - Passive conditional → estus + past passive participle (-ita)
         - Passive imperative → estu + past passive participle (-ita)
         ============================================================================ -->
    
    <!-- Passive verb (standalone): convert to Esperanto periphrastic passive
         
         Handles: "kreesis" → "estis kreita" (was created)
                  "kreesas" → "estas kreata" (is being created)
                  "kreesos" → "estos kreita" (will be created)
                  "kreesar" → "esti kreita" (to be created) -->

    <!-- ============================================================================
         PARTICIPLE RULES
         
         LINGUISTIC CONTEXT:
         Ido and Esperanto have similar participle systems with subtle differences.
         
         IDO PARTICIPLES (active):
         - -ante: present active (vidante = seeing)
         - -inte: past active (vidinte = having seen)
         - -onte: future active (vidonte = about to see)
         
         ESPERANTO PARTICIPLES (active):
         - -anta: present active (vidanta = seeing)
         - -inta: past active (vidinta = having seen)
         - -onta: future active (vidonta = about to see)
         
         Note: Ido uses -e ending for adverbial participles, Esperanto uses -a for adjectival.
         ============================================================================ -->
    
    <!-- Present participle: -ante → -anta (adjectival)
         Handles: "derivante" → "derivanta" -->
    <rule comment="Present participle -ante → -anta">
      <pattern>
        <pattern-item n="pprs"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="vblex"/>
            <lit-tag v="pprs"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>
    
    <!-- Past participle: -ita → -ita
         Handles: "kreita" → "kreita" -->
    <rule comment="Past participle -ita → -ita">
      <pattern>
        <pattern-item n="pp"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="vblex"/>
            <lit-tag v="pp"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Passive verb (standalone): convert to Esperanto periphrastic passive
         
         Handles: "kreesis" → "estis kreita" (was created)
                  "kreesas" → "estas kreata" (is being created)
                  "kreesos" → "estos kreita" (will be created)
                  "kreesar" → "esti kreita" (to be created) -->
    <rule comment="Ido passive → Esperanto esti + participle">
      <pattern>
        <pattern-item n="vbpasv"/>
      </pattern>
      <action>
        <choose>
          <!-- Passive Present: estas + -ita (past passive participle)
               Note: In Esperanto, "estas kreita" is more common than "estas kreata"
               for expressing the passive. This is the statal passive. -->
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pri"/></equal></test>
            <out>
              <lu>
                <lit v="esti"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pres"/>
              </lu>
              <b/>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pp"/>
              </lu>
            </out>
          </when>
          <!-- Passive Past: estis + -ita (past passive participle) -->
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pii"/></equal></test>
            <out>
              <lu>
                <lit v="esti"/>
                <lit-tag v="vblex"/>
                <lit-tag v="past"/>
              </lu>
              <b/>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pp"/>
              </lu>
            </out>
          </when>
          <!-- Passive Future: estos + -ita -->
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="fti"/></equal></test>
            <out>
              <lu>
                <lit v="esti"/>
                <lit-tag v="vblex"/>
                <lit-tag v="fti"/>
              </lu>
              <b/>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pp"/>
              </lu>
            </out>
          </when>
          <!-- Passive Infinitive: esti + -ita -->
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="inf"/></equal></test>
            <out>
              <lu>
                <lit v="esti"/>
                <lit-tag v="vblex"/>
                <lit-tag v="inf"/>
              </lu>
              <b/>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pp"/>
              </lu>
            </out>
          </when>
          <!-- Passive Conditional: estus + -ita -->
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="cni"/></equal></test>
            <out>
              <lu>
                <lit v="esti"/>
                <lit-tag v="vblex"/>
                <lit-tag v="cni"/>
              </lu>
              <b/>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pp"/>
              </lu>
            </out>
          </when>
          <!-- Passive Imperative: estu + -ita -->
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="imp"/></equal></test>
            <out>
              <lu>
                <lit v="esti"/>
                <lit-tag v="vblex"/>
                <lit-tag v="imp"/>
              </lu>
              <b/>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pp"/>
              </lu>
            </out>
          </when>
          <!-- Default: present passive -->
          <otherwise>
            <out>
              <lu>
                <lit v="esti"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pres"/>
              </lu>
              <b/>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="vblex"/>
                <lit-tag v="pp"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- ============================================================================
         VERB + COMPLEMENT RULES (vblex category - all verbs)
         
         LINGUISTIC CONTEXT - THE ACCUSATIVE CASE:
         This is THE fundamental difference between Ido and Esperanto grammar.
         
         Reference: https://en.wikipedia.org/wiki/Comparison_between_Esperanto_and_Ido#Syntax
         
         IDO: No accusative case on nouns/adjectives (word order indicates function)
         - "Me vidas la kato" (I see the cat) - no case marking
         - Direct objects identified by position after transitive verb
         
         ESPERANTO: Mandatory accusative -n on direct objects AND modifying adjectives
         - "Mi vidas la katon" (I see the cat) - accusative -n required
         - "Mi vidas la belan katon" - both adjective and noun take -n
         - Allows flexible word order: "La katon mi vidas" still clear
         
         PRONOUNS: Exception! Both languages mark case on personal pronouns:
         - Ido: me/mi (nom/acc), nos/ni, vu/vu, li/li
         - Esperanto: mi/min, ni/nin, vi/vin, ili/ilin
         
         TECHNICAL NOTES:
         These rules handle complex verb patterns including:
         - Transitive verbs + objects (apply ACCUSATIVE case)
         - Copula + determiners/coordinations (keep NOMINATIVE)
         
         Simple copula patterns are already handled by vbser rules above.
         These rules check for copula (esar/es) explicitly for patterns not
         covered by vbser (e.g., verb + determiner + noun).
         
         These rules apply accusative to nouns, adjectives, AND pronouns when they
         are direct objects of transitive verbs, but keep nominative after copula.
         ============================================================================ -->
    
    <!-- Intransitive Verb + Noun: post-verbal subject stays nominative -->
    <rule>
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <!-- Intransitive verbs: nouns after verb are subjects, not objects -->
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>
    
    <!-- Intransitive Verb + Det + Noun: post-verbal subject with determiner stays nominative

         "la" (det) needs its def/sg/cas tags injected explicitly: the
         bidix hands it over bare, and the generator fails it outright
         without them (a "#la" generation failure, NOT the documented
         harmless "#" artifact for sentence-initial closed-class words; see
         modes.xml: this one occurs mid-sentence after a verb and produces
         wrong output, not just a stray marker). Mirrors the working
         standalone det+nom rule below. -->
    <rule>
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <!-- Intransitive verbs: nouns after verb are subjects, not objects -->
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
            <lit-tag v="def"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu>
            <clip pos="3" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- ============================================================================
         CORRELATIVE (tabelvorto) AGREEMENT across an adjective and after a verb.
         Correlatives are <adj> in Ido (omn<adj>, it<adj>), so the generic adj
         rules below would emit them as ĉiu<adj>/tiu<adj> — which the Esperanto
         generator cannot inflect (#ĉiu). The bare corr_u+nom rule re-emits them
         correctly as LEM<prn><tn><nbr><cas>, but it is only 2 tokens, so an
         intervening adjective or a preceding verb stole the match and broke
         agreement (ta granda domi → "tiu grandaj domoj"; Me vidas ta domi →
         "tiu domojn"). These rules mirror the verb/adj+noun accusative rules but
         emit the correlative with the prn<tn> shape. Placed before the generic
         adj rules so they win by document order.
         ============================================================================ -->
    <!-- Correlative + Adjective + Noun (standalone): agree all three, nominative -->
    <rule comment="correlative + adjective + noun agreement">
      <pattern>
        <pattern-item n="corr_u"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="prn"/><lit-tag v="tn"/>
            <clip pos="3" side="tl" part="nbr"/>
            <clip pos="3" side="tl" part="cas"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="lem"/>
            <clip pos="2" side="tl" part="a_adj"/>
            <clip pos="3" side="tl" part="nbr"/>
            <clip pos="3" side="tl" part="cas"/>
          </lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <!-- Intransitive verb + Correlative + Noun: post-verbal subject stays nominative -->
    <rule comment="intransitive verb + correlative + noun: nominative">
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="corr_u"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="lem"/>
            <lit-tag v="prn"/><lit-tag v="tn"/>
            <clip pos="3" side="tl" part="nbr"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <!-- Verb + Correlative + Noun: accusative if transitive, nominative after copula -->
    <rule comment="verb + correlative + noun: accusative if transitive">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="corr_u"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="prn"/><lit-tag v="tn"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="nom"/>
              </lu>
              <b/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="prn"/><lit-tag v="tn"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_nom"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>
    <!-- Verb + Correlative + Adjective + Noun: accusative if transitive -->
    <rule comment="verb + correlative + adjective + noun: accusative if transitive">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="corr_u"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><lit-tag v="prn"/><lit-tag v="tn"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="4" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><lit-tag v="prn"/><lit-tag v="tn"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
              <b/>
              <lu><clip pos="4" side="tl" part="lem"/><clip pos="4" side="tl" part="a_nom"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Partitive-quantity correlative + Noun (standalone), #206: re-emit
         tanta/quanta as the invariant multiword "tiom da"/"kiom da" with
         <det><qnt|itg><nbr><cas>, leaving the noun bare/nominative: "da"
         governs no case in Esperanto, so the noun never gets -n even when
         the whole phrase is a direct object (that -n, if any, lands on
         "tiom"/"kiom" itself; see the transitive rule below). Must precede
         the generic num/adj rules (equal-length ties, first wins). -->
    <rule comment="partitive-quantity correlative + noun agreement">
      <pattern>
        <pattern-item n="corr_da"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test><equal caseless="yes"><clip pos="1" side="sl" part="lem"/><lit v="tanta"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="qnt"/><clip pos="2" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_nom"/><clip pos="2" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="itg"/><clip pos="2" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_nom"/><clip pos="2" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>
    <!-- Intransitive verb + partitive-quantity correlative + Noun: post-verbal
         subject stays nominative on both the quantifier and the noun. -->
    <rule comment="intransitive verb + partitive-quantity correlative + noun: nominative">
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="corr_da"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test><equal caseless="yes"><clip pos="2" side="sl" part="lem"/><lit v="tanta"/></equal></test>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="qnt"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_nom"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="itg"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_nom"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>
    <!-- Verb + partitive-quantity correlative + Noun: accusative on the
         quantifier if transitive (nominative after copula); the noun after
         "da" always stays nominative regardless. -->
    <rule comment="verb + partitive-quantity correlative + noun: accusative quantifier if transitive">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="corr_da"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <test><equal caseless="yes"><clip pos="2" side="sl" part="lem"/><lit v="tanta"/></equal></test>
            <choose>
              <when>
                <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
                <out>
                  <lu><clip pos="1" side="tl" part="whole"/></lu>
                  <b/>
                  <lu><clip pos="2" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="qnt"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
                  <b/>
                  <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_nom"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
                </out>
              </when>
              <otherwise>
                <out>
                  <lu><clip pos="1" side="tl" part="whole"/></lu>
                  <b/>
                  <lu><clip pos="2" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="qnt"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
                  <b/>
                  <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_nom"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
                </out>
              </otherwise>
            </choose>
          </when>
          <otherwise>
            <choose>
              <when>
                <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
                <out>
                  <lu><clip pos="1" side="tl" part="whole"/></lu>
                  <b/>
                  <lu><clip pos="2" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="itg"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
                  <b/>
                  <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_nom"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
                </out>
              </when>
              <otherwise>
                <out>
                  <lu><clip pos="1" side="tl" part="whole"/></lu>
                  <b/>
                  <lu><clip pos="2" side="tl" part="lem"/><lit v=" da"/><lit-tag v="det"/><lit-tag v="itg"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
                  <b/>
                  <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_nom"/><clip pos="3" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
                </out>
              </otherwise>
            </choose>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Quantifier accusative (#203): kelka/multa/diversa/cetera are mis-tagged
         <num> in the lexicon but agree like adjectives (see the "quant" def-cat
         above and the standalone quant+nom rule below). Those existing rules
         only cover the noun phrase itself; a verb immediately in front left the
         quantifier and noun stuck at nominative even when the verb is
         transitive ("Me havas multa amiki" → "Mi havas multaj amikoj", missing
         -n). These three mirror the corr_u trio above. -->
    <!-- Intransitive verb + Quantifier + Noun: post-verbal subject stays nominative -->
    <rule comment="intransitive verb + quantifier + noun: nominative">
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="quant"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="lem"/>
            <lit-tag v="adj"/>
            <clip pos="3" side="tl" part="nbr"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <!-- Verb + Quantifier + Noun: accusative if transitive, nominative after copula -->
    <rule comment="verb + quantifier + noun: accusative if transitive">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="quant"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="adj"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="nom"/>
              </lu>
              <b/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="adj"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_nom"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>
    <!-- Verb + Quantifier + Adjective + Noun: accusative if transitive -->
    <rule comment="verb + quantifier + adjective + noun: accusative if transitive">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="quant"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><lit-tag v="adj"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="nom"/></lu>
              <b/>
              <lu><clip pos="4" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu><clip pos="2" side="tl" part="lem"/><lit-tag v="adj"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
              <b/>
              <lu><clip pos="3" side="tl" part="lem"/><clip pos="3" side="tl" part="a_adj"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
              <b/>
              <lu><clip pos="4" side="tl" part="lem"/><clip pos="4" side="tl" part="a_nom"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Verb + Adjective + Noun: check if copula or transitive

         Handles: "Me vidas bela kato" → "Mi vidas belan katon" (transitive)
                  "Il esas bela kato" → "Li estas bela kato" (copula)

         LINGUISTIC: Demonstrates the core accusative transformation.
         Adjective AND noun both receive -n in Esperanto when accusative. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is "esar" (to be), keep nominative (predicate) -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <clip pos="2" side="tl" part="a_adj"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="nom"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="whole"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <clip pos="2" side="tl" part="a_adj"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_nom"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Verb + Noun: check if copula or transitive -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is "esar" (to be), keep nominative (predicate) -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <clip pos="2" side="tl" part="a_nom"/>
                <clip pos="2" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Verb + Determiner + Noun: check if copula or transitive

         "la" (det) needs its def/sg/cas tags injected explicitly: see the
         comment on the intransitive-verb version above. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is "esar" (to be), keep nominative (predicate) -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="nom"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="whole"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative to noun -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="acc"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_nom"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Verb + Determiner + Adjective + Noun: check if copula or transitive

         "la" (det) needs its def/sg/cas tags injected explicitly: see the
         comment on the intransitive-verb det+nom rule above. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="det"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is "esar" (to be), keep nominative (predicate) -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="nom"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_adj"/>
                <clip pos="4" side="tl" part="nbr"/>
                <lit-tag v="nom"/>
              </lu>
              <b/>
              <lu>
                <clip pos="4" side="tl" part="whole"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative to both adjective and noun -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="acc"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_adj"/>
                <clip pos="4" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b/>
              <lu>
                <clip pos="4" side="tl" part="lem"/>
                <clip pos="4" side="tl" part="a_nom"/>
                <clip pos="4" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- ============================================================================
         CONJUNCTION RULES - Coordinated Phrases
         
         LINGUISTIC CONTEXT:
         Coordination (kaj/e = "and") presents a challenge because BOTH coordinated
         elements must receive the same case marking in Esperanto.
         
         Reference: https://en.wikipedia.org/wiki/Comparison_between_Esperanto_and_Ido#Syntax
         
         ESPERANTO: All coordinated objects take accusative together:
         - "Mi vidas la katon kaj la hundon" (I see the cat and the dog)
         - Both "katon" and "hundon" receive -n
         
         IDO: No case marking on nouns:
         - "Me vidas la kato kaj la hundo"
         
         TECHNICAL: These rules include the preceding verb to determine case:
         - After transitive verbs (non-esar): apply accusative to ALL coordinated objects
         - After copula: keep nominative for ALL coordinated predicates
         - After subjects or standalone: keep nominative
         ============================================================================ -->
    
    <!-- Verb + Noun + Conjunction + Noun: coordinated objects/subjects after verb
         
         Handles: 
         - Transitive: "Me vidas la kato kaj la hundo" → "Mi vidas la katon kaj la hundon"
         - Intransitive: "jacas Oceano Atlantiko" → "kuŝas Oceano Atlantiko" (subjects stay nominative)
         
         LINGUISTIC: Critical test case for accusative - BOTH nouns must receive same case. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="nom"/>
        <pattern-item n="cnjcoo"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is "esar" (copula), keep nominative for both -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
              </lu>
              <b pos="2"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="3"/></call-macro>
            <out>
              <b pos="3"/>
              <lu>
                <clip pos="4" side="tl" part="whole"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative to both coordinated objects -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <clip pos="2" side="tl" part="a_nom"/>
                <clip pos="2" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="2"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="3"/></call-macro>
            <out>
              <b pos="3"/>
              <lu>
                <clip pos="4" side="tl" part="lem"/>
                <clip pos="4" side="tl" part="a_nom"/>
                <clip pos="4" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Intransitive Verb + Noun + Conjunction + Noun: coordinated subjects stay nominative -->
    <rule>
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="nom"/>
        <pattern-item n="cnjcoo"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <!-- Intransitive verbs: post-verbal nouns are subjects, keep nominative -->
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
          <b pos="1"/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
          <b pos="2"/>
        </out>
        <call-macro n="cnjcoo_lu"><with-param pos="3"/></call-macro>
        <out>
          <b pos="3"/>
          <lu>
            <clip pos="4" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>
    
    <!-- Ditransitive word order (#204): "me donis a la puero la libro" (I gave
         to the boy the book) puts the dative-marked indirect object BEFORE
         the direct object. Without a dedicated rule, the shorter existing
         rules match greedily left-to-right: "a" alone, then "la puero" via
         the standalone det+nom rule (always nominative — correct, it's a
         PP object), leaving "la libro" to ALSO fall into the standalone
         det+nom rule instead of getting the accusative a direct object of a
         transitive verb needs. These four rules span the whole "verb +
         pr_dat + IO + DO" sequence (both objects with or without a
         determiner) so the trailing NP is recognized as the direct object
         and gets the accusative; the dative-marked NP always stays
         nominative (it's an object of "al", not of the verb). The DO-before-IO
         order ("me donis la libro a la puero") already works via the
         ordinary verb+nom / verb+det+nom rules earlier in this file — only
         IO-before-DO needed a new rule. -->
    <rule comment="verb + dative pr + det-IO + det-DO: accusative on the trailing direct object">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="pr_dat"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b pos="1"/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b pos="2"/>
          <lu><clip pos="3" side="tl" part="whole"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
          <b pos="3"/>
          <lu><clip pos="4" side="tl" part="whole"/></lu>
          <b pos="4"/>
          <lu><clip pos="5" side="tl" part="whole"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="acc"/></lu>
          <b pos="5"/>
          <lu><clip pos="6" side="tl" part="lem"/><clip pos="6" side="tl" part="a_nom"/><clip pos="6" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
        </out>
      </action>
    </rule>
    <rule comment="verb + dative pr + det-IO + bare-DO: accusative on the trailing direct object">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="pr_dat"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b pos="1"/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b pos="2"/>
          <lu><clip pos="3" side="tl" part="whole"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
          <b pos="3"/>
          <lu><clip pos="4" side="tl" part="whole"/></lu>
          <b pos="4"/>
          <lu><clip pos="5" side="tl" part="lem"/><clip pos="5" side="tl" part="a_nom"/><clip pos="5" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
        </out>
      </action>
    </rule>
    <rule comment="verb + dative pr + bare-IO + det-DO: accusative on the trailing direct object">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="pr_dat"/>
        <pattern-item n="nom"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b pos="1"/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b pos="2"/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
          <b pos="3"/>
          <lu><clip pos="4" side="tl" part="whole"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="acc"/></lu>
          <b pos="4"/>
          <lu><clip pos="5" side="tl" part="lem"/><clip pos="5" side="tl" part="a_nom"/><clip pos="5" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
        </out>
      </action>
    </rule>
    <rule comment="verb + dative pr + bare-IO + bare-DO: accusative on the trailing direct object">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="pr_dat"/>
        <pattern-item n="nom"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b pos="1"/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b pos="2"/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
          <b pos="3"/>
          <lu><clip pos="4" side="tl" part="lem"/><clip pos="4" side="tl" part="a_nom"/><clip pos="4" side="tl" part="nbr"/><lit-tag v="acc"/></lu>
        </out>
      </action>
    </rule>

    <!-- Verb + Det + Noun + Conjunction + Det + Noun: coordinated objects with determiners

         Both "la"s need their def/sg/cas tags injected explicitly: see the
         comment on the intransitive-verb det+nom rule above. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
        <pattern-item n="cnjcoo"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is "esar" (copula), keep nominative for both -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="nom"/>
              </lu>
              <b pos="2"/>
              <lu>
                <clip pos="3" side="tl" part="whole"/>
              </lu>
              <b pos="3"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="4"/></call-macro>
            <out>
              <b pos="4"/>
              <lu>
                <clip pos="5" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="nom"/>
              </lu>
              <b pos="5"/>
              <lu>
                <clip pos="6" side="tl" part="whole"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative to both coordinated objects -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="2"/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_nom"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="3"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="4"/></call-macro>
            <out>
              <b pos="4"/>
              <lu>
                <clip pos="5" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="5"/>
              <lu>
                <clip pos="6" side="tl" part="lem"/>
                <clip pos="6" side="tl" part="a_nom"/>
                <clip pos="6" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Intransitive Verb + Det + Noun + Conjunction + Det + Noun: coordinated subjects with determiners

         Both "la"s need their def/sg/nom tags injected explicitly: see the
         comment on the intransitive-verb det+nom rule above. -->
    <rule>
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
        <pattern-item n="cnjcoo"/>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <!-- Intransitive verbs: post-verbal nouns are subjects, keep nominative -->
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
          <b pos="1"/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
            <lit-tag v="def"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
          <b pos="2"/>
          <lu>
            <clip pos="3" side="tl" part="whole"/>
          </lu>
          <b pos="3"/>
        </out>
        <call-macro n="cnjcoo_lu"><with-param pos="4"/></call-macro>
        <out>
          <b pos="4"/>
          <lu>
            <clip pos="5" side="tl" part="whole"/>
            <lit-tag v="def"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
          <b pos="5"/>
          <lu>
            <clip pos="6" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Verb + Adjective + Noun + Conjunction + Adjective + Noun: coordinated modified objects -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
        <pattern-item n="cnjcoo"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is "esar" (copula), keep nominative -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <clip pos="2" side="tl" part="a_adj"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="nom"/>
              </lu>
              <b pos="2"/>
              <lu>
                <clip pos="3" side="tl" part="whole"/>
              </lu>
              <b pos="3"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="4"/></call-macro>
            <out>
              <b pos="4"/>
              <lu>
                <clip pos="5" side="tl" part="lem"/>
                <clip pos="5" side="tl" part="a_adj"/>
                <clip pos="6" side="tl" part="nbr"/>
                <lit-tag v="nom"/>
              </lu>
              <b pos="5"/>
              <lu>
                <clip pos="6" side="tl" part="whole"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative to both coordinated objects -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <clip pos="2" side="tl" part="a_adj"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="2"/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_nom"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="3"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="4"/></call-macro>
            <out>
              <b pos="4"/>
              <lu>
                <clip pos="5" side="tl" part="lem"/>
                <clip pos="5" side="tl" part="a_adj"/>
                <clip pos="6" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="5"/>
              <lu>
                <clip pos="6" side="tl" part="lem"/>
                <clip pos="6" side="tl" part="a_nom"/>
                <clip pos="6" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Verb + Det + Adj + Noun + Conjunction + Det + Adj + Noun: coordinated objects with determiners and adjectives

         Both "la"s need their def/sg/cas tags injected explicitly: see the
         comment on the intransitive-verb det+nom rule above. Also fixes a
         second bug found alongside it: the transitive branch applied
         accusative to both coordinated NOUNS but left both coordinated
         ADJECTIVES nominative ("Me havas la bela domo e la granda domo" ->
         "domon" but "bela"/"granda" stayed unmarked): adjectives must
         agree with their own noun's case like everywhere else in this file. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="det"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
        <pattern-item n="cnjcoo"/>
        <pattern-item n="det"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <!-- If verb is copula, keep nominative -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="nom"/>
              </lu>
              <b pos="2"/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
              <b pos="3"/>
              <lu><clip pos="4" side="tl" part="whole"/></lu>
              <b pos="4"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="5"/></call-macro>
            <out>
              <b pos="5"/>
              <lu>
                <clip pos="6" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="nom"/>
              </lu>
              <b pos="6"/>
              <lu><clip pos="7" side="tl" part="whole"/></lu>
              <b pos="7"/>
              <lu><clip pos="8" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive: accusative on both determiners, adjectives, and nouns -->
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b pos="1"/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="2"/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_adj"/>
                <clip pos="4" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="3"/>
              <lu>
                <clip pos="4" side="tl" part="lem"/>
                <clip pos="4" side="tl" part="a_nom"/>
                <clip pos="4" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="4"/>
            </out>
            <call-macro n="cnjcoo_lu"><with-param pos="5"/></call-macro>
            <out>
              <b pos="5"/>
              <lu>
                <clip pos="6" side="tl" part="whole"/>
                <lit-tag v="def"/>
                <lit-tag v="sg"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="6"/>
              <lu>
                <clip pos="7" side="tl" part="lem"/>
                <clip pos="7" side="tl" part="a_adj"/>
                <clip pos="8" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b pos="7"/>
              <lu>
                <clip pos="8" side="tl" part="lem"/>
                <clip pos="8" side="tl" part="a_nom"/>
                <clip pos="8" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Noun + Conjunction + Noun: coordinated subjects or standalone nouns
         Without verb context, we must assume nominative (default case) -->
    <rule>
      <pattern>
        <pattern-item n="nom"/>
        <pattern-item n="cnjcoo"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
          <b pos="1"/>
        </out>
        <call-macro n="cnjcoo_lu"><with-param pos="2"/></call-macro>
        <out>
          <b pos="2"/>
          <lu>
            <clip pos="3" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- ============================================================================
         ADJECTIVE-NOUN AGREEMENT RULES
         
         LINGUISTIC CONTEXT - Adjective Agreement:
         This is another KEY difference between Ido and Esperanto.
         
         Reference: https://en.wikipedia.org/wiki/Comparison_between_Esperanto_and_Ido#Morphology
         
         IDO: Adjectives are completely INVARIABLE
         - "bela kato" (beautiful cat, sg)
         - "bela kati" (beautiful cats, pl) - adjective stays "bela"
         
         ESPERANTO: Adjectives AGREE in number and case
         - "bela kato" (sg, nom)
         - "belaj katoj" (pl, nom) - both take -j
         - "belan katon" (sg, acc) - both take -n
         - "belajn katojn" (pl, acc) - both take -jn
         
         These rules propagate the noun's number and case to modifying adjectives.
         ============================================================================ -->
    
    <!-- Multi-modifier agreement: apertium has no variable-length patterns, so
         the single `adj nom`/`quant nom` rules below only reach the noun-adjacent
         modifier. These enumerate the common 2-modifier noun phrases so EVERY
         modifier agrees with the noun: "nacionala historiala lingui" → "naciaj
         historiaj lingvoj", "kelka diversa homi" → "kelkaj diversaj homoj". -->
    <rule>
      <pattern>
        <pattern-item n="adj"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="lem"/><clip pos="1" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><clip pos="3" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><clip pos="3" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <rule>
      <pattern>
        <pattern-item n="quant"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="lem"/><lit-tag v="adj"/><clip pos="3" side="tl" part="nbr"/><clip pos="3" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><clip pos="3" side="tl" part="nbr"/><clip pos="3" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <rule>
      <pattern>
        <pattern-item n="quant"/>
        <pattern-item n="quant"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="lem"/><lit-tag v="adj"/><clip pos="3" side="tl" part="nbr"/><clip pos="3" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="2" side="tl" part="lem"/><lit-tag v="adj"/><clip pos="3" side="tl" part="nbr"/><clip pos="3" side="tl" part="cas"/></lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>

    <!-- Equative: tam ADJ kam → tiel ADJ kiel (Me esas tam forta kam tu →
         Mi estas tiel forta kiel vi). The adjective defaults to sg/nom — the
         subject is outside this pattern, same default as the standalone adj
         rule. Whatever follows kam (the standard of comparison) is handled by
         its own rules (tu → vi). -->
    <rule comment="equative tam + adj + kam">
      <pattern>
        <pattern-item n="adv_tam"/>
        <pattern-item n="adj"/>
        <pattern-item n="adv_kam"/>
      </pattern>
      <action>
        <out>
          <lu><lit v="tiel"/><lit-tag v="adv"/></lu>
          <b pos="1"/>
          <lu><clip pos="2" side="tl" part="lem"/><clip pos="2" side="tl" part="a_adj"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
          <b pos="2"/>
          <lu><lit v="kiel"/><lit-tag v="adv"/></lu>
        </out>
      </action>
    </rule>

    <!-- Equative: tam ADV kam → tiel ADV kiel (kuras tam rapide kam …). -->
    <rule comment="equative tam + adv + kam">
      <pattern>
        <pattern-item n="adv_tam"/>
        <pattern-item n="adv"/>
        <pattern-item n="adv_kam"/>
      </pattern>
      <action>
        <out>
          <lu><lit v="tiel"/><lit-tag v="adv"/></lu>
          <b pos="1"/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b pos="2"/>
          <lu><lit v="kiel"/><lit-tag v="adv"/></lu>
        </out>
      </action>
    </rule>

    <!-- Correlative determiner + Noun: emit the EO -u tabelvorto as prn+tn
         with the noun's number/case (omna homi → ĉiuj homoj). The generator
         rejects ĉiu/neniu/tiu as <adj> (#ĉiu), so adj agreement can't be used.
         Must precede the generic adj+nom rule (equal-length, first wins). -->
    <rule comment="correlative determiner + noun agreement">
      <pattern>
        <pattern-item n="corr_u"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="prn"/>
            <lit-tag v="tn"/>
            <clip pos="2" side="tl" part="nbr"/>
            <clip pos="2" side="tl" part="cas"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Adjective + Noun: propagate number and case from noun to adjective

         Handles: "bela kato" → "bela kato" (sg nom)
                  "bela kato" → "belan katon" (when in accusative context)

         LINGUISTIC: Implements Esperanto's adjective agreement requirement. -->
    <rule>
      <pattern>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <clip pos="1" side="tl" part="a_adj"/>
            <clip pos="2" side="tl" part="nbr"/>
            <clip pos="2" side="tl" part="cas"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Quantifier + Noun: agree number+case, re-emit as <adj> so EO generates
         the -j/-n forms (kelka triboj → kelkaj triboj; the lexicon's <num> tag
         blocks generation of kelkaj). -->
    <rule>
      <pattern>
        <pattern-item n="quant"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="adj"/>
            <clip pos="2" side="tl" part="nbr"/>
            <clip pos="2" side="tl" part="cas"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Noun rule: pass through (Esperanto nouns don't always have gender) -->
    <rule>
      <pattern>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Adjective rule: add sg/nom for Esperanto (default form when alone) -->
    <rule>
      <pattern>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <clip pos="1" side="tl" part="a_adj"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Adverb rule: pass through -->
    <rule>
      <pattern>
        <pattern-item n="adv"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- ============================================================================
         BASIC WORD CLASS RULES (pass-through or simple transformations)
         ============================================================================ -->
    
    <!-- Verb: convert Ido tense tags to Esperanto tense tags
         Ido: pri (present), pii (past), fti (future), inf (infinitive)
         Esperanto: pres, past, fti, inf
         
         NOTE: Default branch assumes present tense if no tense tag exists.
         This might mask errors from incomplete morphological analysis.
         Consider logging/warning when this fallback is used. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pri"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="pres"/>
              </lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="pii"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="past"/>
              </lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="fti"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="fti"/>
              </lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="cni"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="cni"/>
              </lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="imp"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="imp"/>
              </lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="sl" part="temps"/><lit-tag v="inf"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="inf"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Default: if no tense tag, assume present tense -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="pres"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Verb + Pronoun: apply accusative to pronoun after transitive verb
         
         LINGUISTIC CONTEXT - Personal Pronouns:
         Pronouns are THE EXCEPTION to the Ido "no accusative" rule!
         
         Reference: https://en.wikipedia.org/wiki/Comparison_between_Esperanto_and_Ido#Pronouns
         
         BOTH languages distinguish case in personal pronouns:
         
         IDO pronoun cases:
         - me/mi (I/me), tu/tu (you), il/il (he/him), el/el (she/her)
         - nos/ni (we/us), vi/vi (you-pl), li/li (they/them)
         
         ESPERANTO pronoun cases:
         - mi/min (I/me), vi/vin (you), li/lin (he/him), ŝi/ŝin (she/her)
         - ni/nin (we/us), vi/vin (you-pl), ili/ilin (they/them)
         
         Handles: "Me amas vu" → "Mi amas vin" (I love you - acc)
                  "Il esas me" → "Li estas mi" (He is me - nom after copula)
         
         CRITICAL: Pronouns take different forms for nominative/accusative in BOTH languages. -->
    <!-- Verb + Pronoun: check if copula or transitive -->
    <rule>
      <pattern>
        <pattern-item n="vbconj"/>
        <pattern-item n="prn"/>
      </pattern>
      <action>
        <choose>
          <when>
            <!-- If verb is copula, keep pronoun in nominative -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <!-- Fallback tags if missing from bidix -->
                <lit-tag v="nom"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: add accusative to pronoun -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="prn"/>
                <!-- Inherit person/gender from source if available -->
                <clip pos="2" side="tl" part="pers"/>
                <clip pos="2" side="tl" part="gen"/>
                <clip pos="2" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Adjective rule (standalone): pass through -->
    <!-- Adjectives should translate directly via bilingual dictionary -->
    <rule>
      <pattern>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Preposition + reflexive: a reflexive after a preposition is NOT a direct
         object, so it stays nominative: "pri su" → "pri si" (not "pri sin").
         Two-token pattern wins LRLM over the standalone pr and prn rules. The
         lemma-targeted prn_ref category means no other pronoun reaches this
         rule (the earlier reject-current-rule attempt corrupted personal
         pronouns — this design cannot). -->
    <rule comment="preposition + reflexive pronoun: nominative si">
      <pattern>
        <pattern-item n="pr"/>
        <pattern-item n="prn_ref"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b pos="1"/>
          <lu><lit v="si"/><lit-tag v="prn"/><lit-tag v="ref"/></lu>
        </out>
      </action>
    </rule>

    <!-- ── Verb + pronoun object → Esperanto accusative ────────────────────
         Ido marks no case on a pronoun object, but Esperanto requires it
         (me amas tu → mi amas vin). The pronoun's role is fixed by the verb:
         after a copula (esar), a copulative verb (diveni/resti/ŝajni) or an
         intransitive verb the post-verbal pronoun is a subject/predicate and
         stays NOMINATIVE (prn_to_subj); after any other (transitive) verb it
         is a direct object and takes the ACCUSATIVE (prn_to_obj). Narrow
         verb-class rules precede the general transitive rule so first-match
         routes each verb correctly. The reflexive (su→si) is accusative in
         both macros, preserving "lavas su → lavas sin". Subject and isolated
         pronouns are still handled by the standalone rule below. -->
    <rule comment="copula + pronoun: predicate stays nominative">
      <pattern>
        <pattern-item n="vbser"/>
        <pattern-item n="prn"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out><lu><clip pos="1" side="tl" part="whole"/></lu><b pos="1"/></out>
        <call-macro n="prn_to_subj"><with-param pos="2"/></call-macro>
      </action>
    </rule>
    <rule comment="copulative verb + pronoun: predicate stays nominative">
      <pattern>
        <pattern-item n="vbcop"/>
        <pattern-item n="prn"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out><lu><clip pos="1" side="tl" part="whole"/></lu><b pos="1"/></out>
        <call-macro n="prn_to_subj"><with-param pos="2"/></call-macro>
      </action>
    </rule>
    <rule comment="intransitive verb + pronoun: post-verbal subject stays nominative">
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="prn"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out><lu><clip pos="1" side="tl" part="whole"/></lu><b pos="1"/></out>
        <call-macro n="prn_to_subj"><with-param pos="2"/></call-macro>
      </action>
    </rule>
    <!-- Verb + pronoun + verb: the pronoun is the SUBJECT of the second verb, not
         the object of the first, so it stays NOMINATIVE. This guards the common
         clause-boundary case where a comma (a superblank, invisible to the pattern)
         separates the clauses: "Kande il venis, me dormis" → "Kiam li venis, mi
         dormis" (NOT "min dormis"); "Me savas, il venos" → "li venos". Longer match
         wins over the 2-token object rule below. (Residual: a perception/causative
         verb + pronoun + infinitive — "Me audas tu kantar" — is genuinely
         accusative-with-infinitive and would want "vin"; that case is rare and is
         the price of not being able to test the comma directly in t1x.) -->
    <rule comment="verb + pronoun + verb: pronoun is the 2nd verb's subject, nominative">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="prn"/>
        <pattern-item n="vblex"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <call-macro n="pii_to_past"><with-param pos="3"/></call-macro>
        <out><lu><clip pos="1" side="tl" part="whole"/></lu><b pos="1"/></out>
        <call-macro n="prn_to_subj"><with-param pos="2"/></call-macro>
        <out><b pos="2"/><lu><clip pos="3" side="tl" part="whole"/></lu></out>
      </action>
    </rule>
    <rule comment="transitive verb + pronoun object: accusative (me amas tu → mi amas vin)">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="prn"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <out><lu><clip pos="1" side="tl" part="whole"/></lu><b pos="1"/></out>
        <call-macro n="prn_to_obj"><with-param pos="2"/></call-macro>
      </action>
    </rule>

    <!-- Interrogative determiner ("qua" attributive) + Noun (#205): re-emit
         as EO <det><itg> agreeing with the noun in number/case (qua libro →
         kiu libro; qua libri → kiuj libroj). Longer match than the 2-item
         vblex+prn / standalone prn rules, so it wins regardless of order,
         but grouped here with the other pronoun rules for locality. -->
    <rule comment="interrogative determiner + noun agreement (qua libro)">
      <pattern>
        <pattern-item n="prn_itg"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="det"/>
            <lit-tag v="itg"/>
            <clip pos="2" side="tl" part="nbr"/>
            <clip pos="2" side="tl" part="cas"/>
          </lu>
          <b/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <!-- Intransitive verb + interrogative determiner + Noun: post-verbal
         subject stays nominative. -->
    <rule comment="intransitive verb + interrogative determiner + noun: nominative">
      <pattern>
        <pattern-item n="vbintr"/>
        <pattern-item n="prn_itg"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu><clip pos="1" side="tl" part="whole"/></lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="lem"/>
            <lit-tag v="det"/>
            <lit-tag v="itg"/>
            <clip pos="3" side="tl" part="nbr"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu><clip pos="3" side="tl" part="whole"/></lu>
        </out>
      </action>
    </rule>
    <!-- Verb + interrogative determiner + Noun: accusative if transitive,
         nominative after copula. -->
    <rule comment="verb + interrogative determiner + noun: accusative if transitive">
      <pattern>
        <pattern-item n="vblex"/>
        <pattern-item n="prn_itg"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <call-macro n="pii_to_past"><with-param pos="1"/></call-macro>
        <choose>
          <when>
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="det"/>
                <lit-tag v="itg"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="nom"/>
              </lu>
              <b/>
              <lu><clip pos="3" side="tl" part="whole"/></lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu><clip pos="1" side="tl" part="whole"/></lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="det"/>
                <lit-tag v="itg"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
              <b/>
              <lu>
                <clip pos="3" side="tl" part="lem"/>
                <clip pos="3" side="tl" part="a_nom"/>
                <clip pos="3" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Pronoun rule (standalone): subject / isolated pronoun, nominative.
         The lemma→prpers mapping lives in the prn_to_subj macro (shared with
         the verb+pronoun object rules above, which use the accusative variant). -->
    <rule>
      <pattern>
        <pattern-item n="prn"/>
      </pattern>
      <action>
        <call-macro n="prn_to_subj"><with-param pos="1"/></call-macro>
      </action>
    </rule>

    <!-- Prep-article contraction expansion: dal/del/dil → de/da/di + la -->
    <rule comment="prep-art contraction expansion">
      <pattern>
        <pattern-item n="prep_art"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="pr"/>
          </lu>
          <b/>
          <lu><lit v="la"/><lit-tag v="det"/><lit-tag v="def"/><lit-tag v="sg"/><lit-tag v="nom"/></lu>
        </out>
      </action>
    </rule>

    <!-- Preposition rule: pass through -->
    <rule>
      <pattern>
        <pattern-item n="pr"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Coordinating conjunction rule: pass through, EXCEPT for a set of Ido
         words whose Epo dictionary entry cannot generate under <cnjcoo> at
         all (confirmed with lt-proc -g against epo.autogen.bin):
           ke   -> only <cnjsub> (or <adv>) generates
           se/ĉu/kvankam/tamen/do/nu -> only <cnjsub> or <cnjadv> generate
           ĉar  -> ONLY <cnjadv> generates (not even <cnjsub>)
         These are real Ido words (che/se/kad/quankam/nam/quoniam/tamen/do/or)
         that io_wiktionary tags as a generic "conjunction", same as e/o/ma,
         so the Ido side cannot distinguish them from true coordinators — the
         dispatch has to happen here, on the Epo target lemma, mirroring the
         kiam/kiel special case in the cnjsub rule below. -->
    <rule>
      <pattern>
        <pattern-item n="cnjcoo"/>
      </pattern>
      <action>
        <call-macro n="cnjcoo_lu"><with-param pos="1"/></call-macro>
      </action>
    </rule>

    <!-- Subordinating conjunction rule: pass through.
         kiam/kiel/kvankam are tagged as adv/cnjcoo in Epo generator; use adv for those. -->
    <rule>
      <pattern>
        <pattern-item n="cnjsub"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test><or>
              <equal><clip pos="1" side="tl" part="lem"/><lit v="kiam"/></equal>
              <equal><clip pos="1" side="tl" part="lem"/><lit v="kiel"/></equal>
            </or></test>
            <out><lu><clip pos="1" side="tl" part="lem"/><lit-tag v="adv"/></lu></out>
          </when>
          <otherwise>
            <out><lu><clip pos="1" side="tl" part="whole"/></lu></out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Determiner rule: add def/sg/nom for la (compatible with upstream epo.autogen.bin) -->
    <rule>
      <pattern>
        <pattern-item n="det"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <lit-tag v="def"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>
    
    <!-- Determiner + Adjective + Noun: ensure agreement -->
    <rule>
      <pattern>
        <pattern-item n="det"/>
        <pattern-item n="adj"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <lit-tag v="def"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="lem"/>
            <clip pos="2" side="tl" part="a_adj"/>
            <clip pos="3" side="tl" part="nbr"/>
            <clip pos="3" side="tl" part="cas"/>
          </lu>
          <b/>
          <lu>
            <clip pos="3" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>
    
    <!-- Determiner + Noun: ensure agreement -->
    <rule>
      <pattern>
        <pattern-item n="det"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <lit-tag v="def"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- ============================================================================
         PROPER NOUN RULES
         ============================================================================ -->
    
    <!-- Proper noun (standalone): pass through -->
    <rule>
      <pattern>
        <pattern-item n="np"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <!-- Fallback tags for unknown proper nouns -->
            <lit-tag v="al"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Verb + Proper noun: check if copula or transitive -->
    <rule>
      <pattern>
        <pattern-item n="vbconj"/>
        <pattern-item n="np"/>
      </pattern>
      <action>
        <choose>
          <when>
            <!-- If verb is copula, keep nominative -->
            <test><or><equal><clip pos="1" side="sl" part="lem"/><lit v="esar"/></equal><equal><clip pos="1" side="sl" part="lem"/><lit v="es"/></equal></or></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="whole"/>
                <lit-tag v="al"/>
                <lit-tag v="sg"/>
                <lit-tag v="nom"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Transitive verb: apply accusative to proper noun object -->
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
              <b/>
              <lu>
                <clip pos="2" side="tl" part="lem"/>
                <lit-tag v="np"/>
                <!-- Inherit tags from bidix if available -->
                <clip pos="2" side="tl" part="np_type"/>
                <clip pos="2" side="tl" part="nbr"/>
                <lit-tag v="acc"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>
    <!-- Compound numeral: Ido joins number words with "e" (dek e du = 12),
         Esperanto juxtaposes them (dek du). Drop the conjunction. Restricted to
         e/ed so "du o tri" (two or three) keeps its aŭ. Longer match wins over the
         bare num+num rule below. -->
    <rule comment="number + e + number → juxtaposed (dek e du → dek du)">
      <pattern>
        <pattern-item n="num"/>
        <pattern-item n="cnjcoo_e"/>
        <pattern-item n="num"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
          <b pos="1"/>
          <lu>
            <clip pos="3" side="tl" part="whole"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>
    <!-- Big Numbers: combine two adjacent numerals (e.g., 4 803 -> 4 803) -->
    <rule>
      <pattern>
        <pattern-item n="num"/>
        <pattern-item n="num"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Numeral: pass through and add sp/nom for epo compatibility -->
    <rule>
      <pattern>
        <pattern-item n="num"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Determiner + Ordinal + Noun: ensure agreement -->
    <rule>
      <pattern>
        <pattern-item n="det"/>
        <pattern-item n="ord"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
            <lit-tag v="def"/>
            <lit-tag v="sg"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="lem"/>
            <lit-tag v="num"/>
            <lit-tag v="ord"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu>
            <clip pos="3" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Ordinal + Noun: propagate number and case to ordinal -->
    <rule>
      <pattern>
        <pattern-item n="ord"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="num"/>
            <lit-tag v="ord"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
          <b/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Ordinal: default to singular nominative if alone -->
    <rule>
      <pattern>
        <pattern-item n="ord"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="num"/>
            <lit-tag v="ord"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>
  </section-rules>
</transfer>
