<?xml version="1.0" encoding="UTF-8"?>
<transfer default="lu">
  <section-def-cats>
    <def-cat n="nom">
      <cat-item tags="n.*"/>
    </def-cat>
    <def-cat n="adj">
      <cat-item tags="adj"/>
      <cat-item tags="adj.*"/>
    </def-cat>
    <def-cat n="adv">
      <cat-item tags="adv"/>
      <cat-item tags="adv.*"/>
    </def-cat>
    <def-cat n="num">
      <cat-item tags="num"/>
      <cat-item tags="num.*"/>
    </def-cat>
    <def-cat n="num_ciph">
      <cat-item tags="num.ciph.sp.nom"/>
      <cat-item tags="num.ciph.sp.acc"/>
      <cat-item tags="num.percent.sp.nom"/>
      <cat-item tags="num.percent.sp.acc"/>
      <cat-item tags="num"/>
    </def-cat>
    <def-cat n="vblex">
      <cat-item tags="vblex.*"/>
      <cat-item tags="vbtr.*"/>
      <cat-item tags="vbser.*"/>
      <cat-item tags="vbntr.*"/>
    </def-cat>
    <def-cat n="prn">
      <cat-item tags="prn.*"/>
    </def-cat>
    <def-cat n="pr">
      <cat-item tags="pr"/>
      <cat-item tags="pr.*"/>
    </def-cat>
    <def-cat n="cnjcoo">
      <cat-item tags="cnjcoo"/>
    </def-cat>
    <def-cat n="cnjsub">
      <cat-item tags="cnjsub"/>
    </def-cat>
    <def-cat n="det">
      <cat-item tags="det"/>
      <cat-item tags="det.*"/>
    </def-cat>
    <def-cat n="np">
      <cat-item tags="np"/>
      <cat-item tags="np.*"/>
    </def-cat>
    <def-cat n="ij">
      <cat-item tags="ij"/>
    </def-cat>
    <def-cat n="plej">
      <cat-item lemma="plej" tags="adv"/>
    </def-cat>
    <def-cat n="da">
      <cat-item lemma="da" tags="pr"/>
    </def-cat>
    <!-- Ido equality comparison "tam ADJ kam" / place "hike" (Esperanto
         "tiel ADJ kiel" / "ĉi tie"): lemma-restricted, matched on the SL side. -->
    <def-cat n="tiel_adv">
      <cat-item lemma="tiel" tags="adv"/>
    </def-cat>
    <def-cat n="kiel_adv">
      <cat-item lemma="kiel" tags="adv"/>
    </def-cat>
    <def-cat n="ci_det">
      <cat-item lemma="ĉi" tags="det.*"/>
    </def-cat>
    <def-cat n="tie_adv">
      <cat-item lemma="tie" tags="adv"/>
    </def-cat>
  </section-def-cats>

  <section-def-attrs>
    <def-attr n="a_nom">
      <attr-item tags="n"/>
    </def-attr>
    <def-attr n="a_fem">
      <attr-item tags="f"/>
    </def-attr>
    <def-attr n="a_adj">
      <attr-item tags="adj"/>
    </def-attr>
    <def-attr n="a_prn">
      <attr-item tags="prn"/>
    </def-attr>
    <def-attr n="a_adv">
      <attr-item tags="adv"/>
    </def-attr>
    <def-attr n="a_vblex">
      <attr-item tags="vblex"/>
      <attr-item tags="vbtr"/>
      <attr-item tags="vbser"/>
      <attr-item tags="vbntr"/>
    </def-attr>
    <def-attr n="nbr">
      <attr-item tags="sg"/>
      <attr-item tags="pl"/>
      <attr-item tags="sp"/>
    </def-attr>
    <def-attr n="cas">
      <attr-item tags="nom"/>
      <attr-item tags="acc"/>
    </def-attr>
    <def-attr n="gen">
      <attr-item tags="m"/>
      <attr-item tags="f"/>
      <attr-item tags="mf"/>
      <attr-item tags="nt"/>
    </def-attr>
    <!-- Base POS + derivation of an Ido derived noun target (lernanto ->
         lern<vblex><der_pres><n>, vortaro -> vort<n><der_aro><n>). The Ido
         generator needs the whole chain; clipping only a_nom left lern<n>
         -> #lern. -->
    <def-attr n="a_der">
      <attr-item tags="vblex.der_pres"/>
      <attr-item tags="vblex.der_past"/>
      <attr-item tags="vblex.der_onto"/>
      <attr-item tags="vblex.der_act"/>
      <attr-item tags="n.der_aro"/>
      <attr-item tags="n.der_aj"/>
      <attr-item tags="adj.der_qual"/>
      <attr-item tags="adj.der_aj"/>
    </def-attr>
    <!-- The derivations the adjective rule keeps (below): participles and
         adjective-based ones. Not n.der_ala/n.der_oz: the bidix generates
         those from a noun pair onto the EO adjective of the noun (japoniano
         -> japano gives japonian<n><der_ala> -> japana), where the plain Ido
         adjective japoniana is the translation, not japonianala. -->
    <def-attr n="a_der_adj">
      <attr-item tags="vblex.der_pprs"/>
      <attr-item tags="vblex.der_ppra"/>
      <attr-item tags="vblex.der_ppas"/>
      <attr-item tags="vblex.der_ppa"/>
      <attr-item tags="vblex.der_pfut"/>
      <attr-item tags="vblex.der_onta"/>
      <attr-item tags="n.der_ala"/>
      <attr-item tags="n.der_oz"/>
    </def-attr>
    <def-attr n="a_der_nocase">
      <attr-item tags="der_ppa"/>
      <attr-item tags="der_onta"/>
    </def-attr>
    <def-attr n="temps">
      <attr-item tags="pres"/>
      <attr-item tags="past"/>
      <attr-item tags="inf"/>
      <attr-item tags="pri"/>
      <attr-item tags="pii"/>
      <attr-item tags="fti"/>
    </def-attr>
  </section-def-attrs>

  <section-def-vars>
    <def-var n="dummy"/>
  </section-def-vars>

  <section-def-macros>
    <!-- Adjective: plain adjectives keep lemma + <adj>; Ido participle/derived
         adjectives keep their derivation chain (see a_der_adj). Shared by the
         single-adjective rule and the "tiel ADJ kiel" rule. -->
    <def-macro n="adj_to_ido" npar="1">
      <choose>
            <when>
              <test><equal><clip pos="1" side="tl" part="a_der_adj"/><lit v=""/></equal></test>
              <out>
                <lu>
                  <clip pos="1" side="tl" part="lem"/>
                  <clip pos="1" side="tl" part="a_adj"/>
                </lu>
              </out>
            </when>
            <when>
              <test><equal><clip pos="1" side="tl" part="a_der_nocase"/><lit v=""/></equal></test>
              <out>
                <lu>
                  <clip pos="1" side="tl" part="lem"/>
                  <clip pos="1" side="tl" part="a_der_adj"/>
                  <clip pos="1" side="tl" part="a_adj"/>
                  <lit-tag v="sg"/>
                  <lit-tag v="nom"/>
                </lu>
              </out>
            </when>
            <otherwise>
              <out>
                <lu>
                  <clip pos="1" side="tl" part="lem"/>
                  <clip pos="1" side="tl" part="a_der_adj"/>
                  <clip pos="1" side="tl" part="a_adj"/>
                  <lit-tag v="sg"/>
                </lu>
              </out>
            </otherwise>
          </choose>
    </def-macro>
  </section-def-macros>

  <section-rules>
    <!-- ============================================================================
         BASIC WORD CLASS TRANSFORMATIONS
         These rules strip Esperanto-specific features that don't exist in Ido
         ============================================================================ -->
    
    <!-- Noun: keep number and the feminine (bovo<n><f> -> bovino), drop the
         Esperanto accusative.
         Esperanto marks the direct object with -n (domo → domon, domoj → domojn);
         Ido nouns are caseless (object is fixed by word order), and the Ido n
         paradigm only generates the nominative — passing <acc> through yielded an
         ungeneratable dom<n><sg><acc> → #dom. So force <nom>; number (sg/pl) is
         kept since Ido nouns DO inflect for it (domo / domi). -->
    <rule>
      <pattern>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <clip pos="1" side="tl" part="a_der"/>
            <clip pos="1" side="tl" part="a_nom"/>
            <clip pos="1" side="tl" part="a_fem"/>
            <clip pos="1" side="tl" part="nbr"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Adjective: drop the Esperanto number/case agreement tags.

         Esperanto: Adjectives agree with nouns (bela kato, bela**j** kato**j**)
         Ido: Adjectives are invariable (bela kato, bela kati)

         The Ido a__adj paradigm generates from a bare `lemma<adj>` (granda),
         with NO number tag — emitting <sg> here (the old behaviour) yielded an
         ungeneratable `grand<adj><sg>` → #grand. So output just `lemma<adj>`.
         A participle target is the exception: its derivation paradigm
         generates only <sg><nom> (interesata), or a bare <sg> for -inta/-onta. -->
    <rule>
      <pattern>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <call-macro n="adj_to_ido"><with-param pos="1"/></call-macro>
      </action>
    </rule>

    <!-- Adverb rule: pass through -->
    <rule>
      <pattern>
        <pattern-item n="adv"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Verb: convert Esperanto tense tags to Ido tags
         
         Tense mapping:
         - Esperanto "pres" → Ido "pri" (present)
         - Esperanto "past" → Ido "pii" (past)
         - Other tenses (inf, fti, cni, imp) → pass through
         
         NOTE: Otherwise branch passes whole tag sequence through, which works
         for tenses that are the same in both languages (like fti = future).
         This is cleaner than the Ido→Esperanto direction which has a potentially
         problematic default assumption. -->
    <rule>
      <pattern>
        <pattern-item n="vblex"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test><equal><clip pos="1" side="tl" part="temps"/><lit-tag v="pres"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="pri"/>
              </lu>
            </out>
          </when>
          <when>
            <test><equal><clip pos="1" side="tl" part="temps"/><lit-tag v="past"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <clip pos="1" side="tl" part="a_vblex"/>
                <lit-tag v="pii"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <!-- Participles: the bidix maps them to Ido participle adjectives
                 (skribitajn -> skrib<vblex><der_ppas><adj><pl><acc>). Ido
                 adjectives don't agree, and the Ido monodix generates them only
                 as <sg><nom>, except -inta/-onta (der_ppa/der_onta), which
                 take a bare <sg>. -->
            <let><clip pos="1" side="tl" part="nbr"/><lit-tag v="sg"/></let>
            <choose>
              <when>
                <test><not><equal><clip pos="1" side="tl" part="a_der_nocase"/><lit v=""/></equal></not></test>
                <let><clip pos="1" side="tl" part="cas"/><lit v=""/></let>
              </when>
              <otherwise>
                <let><clip pos="1" side="tl" part="cas"/><lit-tag v="nom"/></let>
              </otherwise>
            </choose>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Pronoun: lemma + <prn>. The Ido pronoun paradigm (__prn) has no case
         (the accusative is only for inverted word order, not generated), so
         a case the bidix left on the target (sin -> su<prn><ref><acc>) must
         not be passed on: su<prn><acc> -> #su. Number and gender are in the
         Ido lemma itself (il/el/ol, li). -->
    <rule>
      <pattern>
        <pattern-item n="prn"/>
      </pattern>
      <action>
        <choose>
          <!-- Ido demonstratives are adjectives (tiu -> ta<adj>, ĉi tiu -> ca):
               forcing <prn> onto such a bidix target left t<prn> -> #t. -->
          <when>
            <test><equal><clip pos="1" side="tl" part="a_adj"/><lit-tag v="adj"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="adj"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="prn"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Preposition rule: pass through -->
    <rule>
      <pattern>
        <pattern-item n="pr"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Coordinating conjunction rule: pass through -->
    <rule>
      <pattern>
        <pattern-item n="cnjcoo"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Subordinating conjunction rule: pass through -->
    <rule>
      <pattern>
        <pattern-item n="cnjsub"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="whole"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Determiner: strip definiteness/number tags
         
         Esperanto: "la" (the) doesn't inflect
         Ido: "la" (the) also doesn't inflect
         
         Both languages have simple, invariable definite articles, so this
         stripping makes sense. Other determiners may vary. -->
    <rule>
      <pattern>
        <pattern-item n="det"/>
      </pattern>
      <action>
        <choose>
          <!-- Ido determiner-adjectives (neniu homo -> nula homo, tiu homo
               -> ta homo): keep the bidix target's adj, as the prn rule does. -->
          <when>
            <test><equal><clip pos="1" side="tl" part="a_adj"/><lit-tag v="adj"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="adj"/>
              </lu>
            </out>
          </when>
          <!-- ... and an Ido pronoun target (ĉi -> ca<prn>): #ca<det> otherwise. -->
          <when>
            <test><equal><clip pos="1" side="tl" part="a_prn"/><lit-tag v="prn"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="prn"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="det"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Proper noun: Ido names are invariable (the Ido monodix has a bare
         Francia<np>), so apertium-epo's subtype, number and case are dropped
         (Francion → Francia). -->
    <rule>
      <pattern>
        <pattern-item n="np"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="np"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Number with ciph rule: pass through unchanged (numbers same in both languages) -->
    <rule>
      <pattern>
        <pattern-item n="num_ciph"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="sl" part="lem"/>
            <lit-tag v="num"/>
            <lit-tag v="ciph"/>
            <lit-tag v="sp"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Number word (du, tri, unu, dek...): apertium-epo tags it <num><sp>
         (or <sg>), but Ido numerals are bare <num> in the monodix, so passing
         the number tag through left du<num><sp> ungeneratable (#du). Keep the
         bidix lemma and emit plain <num>. Must stay AFTER the num_ciph rule:
         both are one-item patterns, and document order breaks the tie. -->
    <rule>
      <pattern>
        <pattern-item n="num"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <lit-tag v="num"/>
          </lu>
        </out>
      </action>
    </rule>


    <!-- ============================================================================
         MULTI-WORD EXPRESSION RULES
         These handle phrasal patterns that translate differently
         ============================================================================ -->
    
    <!-- Superlative construction: plej ADJ → maxim ADJ
         
         Esperanto: "plej bela" (most beautiful)
         Ido: "maxim bela" (most beautiful)
         
         OPTIMIZATION: This only handles "plej + adjective" patterns.
         Missing patterns:
         - "plej" + adverb ("plej rapide" → "maxim rapide")
         - Comparative "pli" ("pli bela" → "plu bela")
         
         Consider adding rules for other degree constructions. -->
    <rule>
      <pattern>
        <pattern-item n="plej"/>
        <pattern-item n="adj"/>
      </pattern>
      <action>
        <out>
          <lu>
            <lit v="maxim"/>
            <lit-tag v="adv"/>
          </lu>
          <b pos="1"/>
          <lu>
            <clip pos="2" side="tl" part="lem"/>
            <clip pos="2" side="tl" part="a_adj"/>
          </lu>
        </out>
      </action>
    </rule>

    <!-- Partitive construction: NOUN da NOUN → NOUN de NOUN (glaso da akvo →
         glaso de aquo). The preposition comes from the bidix (da → de); both
         nouns are output like the plain noun rule (number kept, <acc> dropped:
         tason da kafo → taso de kafeo). -->
    <rule>
      <pattern>
        <pattern-item n="nom"/>
        <pattern-item n="da"/>
        <pattern-item n="nom"/>
      </pattern>
      <action>
        <out>
          <lu>
            <clip pos="1" side="tl" part="lem"/>
            <clip pos="1" side="tl" part="a_der"/>
            <clip pos="1" side="tl" part="a_nom"/>
            <clip pos="1" side="tl" part="a_fem"/>
            <clip pos="1" side="tl" part="nbr"/>
            <lit-tag v="nom"/>
          </lu>
          <b pos="1"/>
          <lu>
            <clip pos="2" side="tl" part="whole"/>
          </lu>
          <b pos="2"/>
          <lu>
            <clip pos="3" side="tl" part="lem"/>
            <clip pos="3" side="tl" part="a_der"/>
            <clip pos="3" side="tl" part="a_nom"/>
            <clip pos="3" side="tl" part="a_fem"/>
            <clip pos="3" side="tl" part="nbr"/>
            <lit-tag v="nom"/>
          </lu>
        </out>
      </action>
    </rule>
    <!-- Interjection rule -->
    <rule>
      <pattern>
        <pattern-item n="ij"/>
      </pattern>
      <action>
        <choose>
          <when>
            <test>
              <equal>
                <clip pos="1" side="sl" part="lem"/>
                <lit v="saluton"/>
              </equal>
            </test>
            <out>
              <lu>
                <lit v="saluto"/>
                <lit-tag v="ij"/>
              </lu>
            </out>
          </when>
          <!-- A set greeting Ido lists as a noun (bonan tagon<ij> -> bona
               jorn<n>) generates in the singular nominative. -->
          <when>
            <test><equal><clip pos="1" side="tl" part="a_nom"/><lit-tag v="n"/></equal></test>
            <out>
              <lu>
                <clip pos="1" side="tl" part="lem"/>
                <lit-tag v="n"/><lit-tag v="sg"/><lit-tag v="nom"/>
              </lu>
            </out>
          </when>
          <otherwise>
            <out>
              <lu>
                <clip pos="1" side="tl" part="whole"/>
              </lu>
            </out>
          </otherwise>
        </choose>
      </action>
    </rule>

    <!-- Equality comparison: Esperanto "tiel ADJ/ADV kiel" is Ido "tam ... kam"
         (the bidix word-for-word tal/qual would give "tale forta quale"). -->
    <rule comment="tiel ADJ kiel -> tam ADJ kam">
      <pattern>
        <pattern-item n="tiel_adv"/>
        <pattern-item n="adj"/>
        <pattern-item n="kiel_adv"/>
      </pattern>
      <action>
        <out><lu><get-case-from pos="1"><lit v="tam"/></get-case-from><lit-tag v="adv"/></lu><b pos="1"/></out>
        <call-macro n="adj_to_ido"><with-param pos="2"/></call-macro>
        <out><b pos="2"/><lu><get-case-from pos="3"><lit v="kam"/></get-case-from><lit-tag v="adv"/></lu></out>
      </action>
    </rule>
    <rule comment="tiel ADV kiel -> tam ADV kam">
      <pattern>
        <pattern-item n="tiel_adv"/>
        <pattern-item n="adv"/>
        <pattern-item n="kiel_adv"/>
      </pattern>
      <action>
        <out>
          <lu><get-case-from pos="1"><lit v="tam"/></get-case-from><lit-tag v="adv"/></lu>
          <b pos="1"/>
          <lu><clip pos="2" side="tl" part="whole"/></lu>
          <b pos="2"/>
          <lu><get-case-from pos="3"><lit v="kam"/></get-case-from><lit-tag v="adv"/></lu>
        </out>
      </action>
    </rule>

    <!-- "ĉi tie" is the single Ido adverb "hike" (not "ca ibe"). -->
    <rule comment="ĉi tie -> hike">
      <pattern>
        <pattern-item n="ci_det"/>
        <pattern-item n="tie_adv"/>
      </pattern>
      <action>
        <out><lu><get-case-from pos="1"><lit v="hik"/></get-case-from><lit-tag v="adv"/></lu></out>
      </action>
    </rule>
  </section-rules>
</transfer>
