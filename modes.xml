<?xml version="1.0" encoding="UTF-8"?>
<modes>

  <mode name="ido-epo" install="yes">
    <pipeline>
      <!-- Split the elided definite article l' (= la before a vowel): lttoolbox
           cannot tokenize the glued clitic (l'unika), so normalise l' -> "la "
           before analysis. The apostrophe is written \x27 to keep the mode
           shell-quoting clean; covers lowercase and sentence-initial L'. -->
      <!-- -u (line-buffered) is REQUIRED: apertium-apy keeps the pipeline as
           persistent streaming processes, and block-buffered sed never flushes
           → 503 hangs in production. \x20 (not a literal space) stops APy's
           whitespace tokenizer from splitting the quoted expression. Both also
           work for the one-shot `apertium` CLI. -->
      <program name="sed -u -e 's/l\x27/la\x20/g' -e 's/L\x27/La\x20/g'"/>
      <program name="lt-proc">
        <file name="ido-epo.automorf.bin"/>
      </program>
      <program name="apertium-pretransfer -n"/>
      <program name="lt-proc -b">
        <file name="ido-epo.autobil.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="apertium-ido-epo.ido-epo.t1x"/>
        <file name="ido-epo.t1x.bin"/>
      </program>
      <!-- Plain -g (NOT -n): -n suppressed ALL unknown-word marks, including the
           "*" the frontend needs to flag genuinely untranslatable Ido words and
           compute its quality score (without it every text scored 100%). The
           cosmetic "#" that -n was meant to hide (the EO autogen echoes the
           lemma for sentence-start closed-class words like La<det>/Kiu<prn>,
           whose surface form is actually correct) is dropped by the final sed
           instead — that strips only "#" and preserves "*" (red/unknown) and
           "@" (orange/bidix-gap). -->
      <program name="lt-proc -g">
        <file name="ido-epo.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="ido-epo.autopgen.bin"/>
      </program>
      <!-- Strip the unreliable "#" generation-failure mark (mix of false
           positives on correct closed-class words and honest gaps lt-proc can't
           tell apart) while keeping "*"/"@". -u is required for APy streaming. -->
      <program name="sed -u -e 's/#//g'"/>
    </pipeline>
  </mode>

  <mode name="epo-ido" install="yes">
    <pipeline>
      <program name="lt-proc">
        <file name="epo-ido.automorf.bin"/>
      </program>
      <program name="cg-proc">
        <file name="epo-ido.rlx.bin"/>
      </program>
      <program name="apertium-pretransfer -n"/>
      <program name="lt-proc -b">
        <file name="epo-ido.autobil.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="apertium-ido-epo.epo-ido.t1x"/>
        <file name="epo-ido.t1x.bin"/>
      </program>
      <program name="lt-proc -g">
        <file name="epo-ido.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="epo-ido.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

</modes>
