<?xml version="1.0" encoding="UTF-8"?>
<modes>

  <mode name="ido-epo" install="yes">
    <pipeline>
      <!-- The elided definite article l' (= la before a vowel) is a clitic unit
           of the Ido analyser (type="postblank" section "apostrophes", as in
           apertium-fra/cat/ita): l'unika is analysed as la + unika with no
           pre-processing. -->
      <program name="lt-proc">
        <file name="ido-epo.automorf.bin"/>
      </program>
      <!-- Disambiguate: drop paradigm-generated derivational readings
           (der_aj/-ajo, der_aro/-aro) when a fully lexicalized reading exists
           for the same surface, so the real word wins the phantom derivation
           (e.g. vilajo -> vilaĝo, not @vil). Mirrors the cg-proc stage the
           epo-ido mode already uses. -->
      <program name="cg-proc">
        <file name="ido-epo.rlx.bin"/>
      </program>
      <program name="apertium-pretransfer -n"/>
      <program name="lt-proc -b">
        <file name="ido-epo.autobil.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="apertium-ido-epo.ido-epo.t1x"/>
        <file name="ido-epo.t1x.bin"/>
      </program>
      <!-- Plain -g (NOT -n): -n suppressed ALL unknown-word marks, including the
           "*" the frontend needs to flag genuinely untranslatable Ido words and
           compute its quality score (without it every text scored 100%). With
           plain -g the output keeps the standard Apertium marks: "*" (unknown),
           "@" (bidix gap) and "#" (generation failure). The "#" mark is noisy
           here (the EO autogen echoes the lemma for sentence-start closed-class
           words like La<det>/Kiu<prn>, whose surface form is actually correct),
           so consumers that want to hide it strip "#" downstream — the
           translator frontend does this in its display normalizer. The mode
           itself stays a pure apertium/lttoolbox/cg pipeline. -->
      <program name="lt-proc -g">
        <file name="ido-epo.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="ido-epo.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

  <mode name="epo-ido" install="yes">
    <pipeline>
      <!-- Detach a period that follows a word so lt-proc tokenises it. apertium-epo
           keeps '.' in its alphabet (needed for decimals like 3.14), so "domo." is
           read as ONE maximal token and fails (*domo.) — unlike '!?:;' which are not
           in the alphabet and split on their own. Insert a space between a LETTER and
           a following '.' so it becomes "domo ." → domo<n> + .<sent> (apertium-epo
           already analyses a lone '.'). Only a LETTER triggers it, so 3.14 / ordinals
           (digit before '.') stay intact; this also covers the sentence-terminator
           '.' apertium-destxt appends, which otherwise glues the final word. The
           post-generation sed below removes the inserted space again. -u + \x20 for
           the same APy-streaming reasons as the ido-epo l' sed. -->
      <program name="sed -u -e 's/\([a-zA-Z]\)\./\1\x20./g'"/>
      <program name="lt-proc">
        <file name="epo-ido.automorf.bin"/>
      </program>
      <program name="cg-proc">
        <file name="epo-ido.rlx.bin"/>
      </program>
      <program name="apertium-pretransfer -n"/>
      <program name="lt-proc -b">
        <file name="epo-ido.autobil.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="apertium-ido-epo.epo-ido.t1x"/>
        <file name="epo-ido.t1x.bin"/>
      </program>
      <program name="lt-proc -g">
        <file name="epo-ido.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="epo-ido.autopgen.bin"/>
      </program>
      <!-- Re-join the period(s) detached by the pre-analysis sed above: drop the
           inserted space before each '.' so "granda . la hundo ." → "granda. la
           hundo.". -->
      <program name="sed -u -e 's/\x20\././g'"/>
    </pipeline>
  </mode>

</modes>
