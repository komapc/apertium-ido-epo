<?xml version="1.0" encoding="UTF-8"?>
<modes>

  <mode name="ido-epo" install="yes">
    <pipeline>
      <!-- Split the elided definite article l' (= la before a vowel): lttoolbox
           cannot tokenize the glued clitic (l'unika), so normalise l' -> "la "
           before analysis. The apostrophe is written \x27 to keep the mode
           shell-quoting clean; covers lowercase and sentence-initial L'. -->
      <program name="sed -e 's/l\x27/la /g' -e 's/L\x27/La /g'"/>
      <program name="lt-proc">
        <file name="ido-epo.automorf.bin"/>
      </program>
      <program name="apertium-pretransfer -n"/>
      <program name="lt-proc -b">
        <file name="ido-epo.autobil.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="apertium-ido-epo.ido-epo.t1x"/>
        <file name="ido-epo.t1x.bin"/>
      </program>
      <!-- -n: drop "#" markers from generation. The EO autogen falls back to
           lemma-as-surface for sentence-start closed-class words (La<det>,
           Kiu<prn>) because the dict only has lowercase entries; the surface
           form is correct, so suppress the cosmetic flag. -->
      <program name="lt-proc -n -g">
        <file name="ido-epo.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="ido-epo.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

  <mode name="epo-ido" install="yes">
    <pipeline>
      <program name="lt-proc">
        <file name="epo-ido.automorf.bin"/>
      </program>
      <program name="cg-proc">
        <file name="epo-ido.rlx.bin"/>
      </program>
      <program name="apertium-pretransfer -n"/>
      <program name="lt-proc -b">
        <file name="epo-ido.autobil.bin"/>
      </program>
      <program name="apertium-transfer -b">
        <file name="apertium-ido-epo.epo-ido.t1x"/>
        <file name="epo-ido.t1x.bin"/>
      </program>
      <program name="lt-proc -g">
        <file name="epo-ido.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="epo-ido.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

</modes>
